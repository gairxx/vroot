COMMANDS = {
    "add": cmd_add, "set": cmd_set, "link": cmd_link, "unlink": cmd_unlink,
    "rm": cmd_rm, "get": cmd_get, "list": cmd_list, "query": cmd_query,
    "impact": cmd_impact, "path": cmd_path, "stats": cmd_stats,
    "check": cmd_check, "ingest": cmd_ingest, "guard": cmd_guard,
    "index": cmd_index, "sql": cmd_sql, "export": cmd_export,
    "schema": cmd_schema, "help": cmd_help,
}


def main(argv):
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    if not argv or argv[0] in ("-h", "--help", "help"):
        cmd_help([])
        return 0
    cmd = argv[0]
    if cmd not in COMMANDS:
        die(f"unknown command {cmd!r} (try: graphctl help)")
    return COMMANDS[cmd](argv[1:]) or 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
