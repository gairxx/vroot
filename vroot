#!/usr/bin/env bash
set -euo pipefail
umask 077

VERSION="2.1.0"

# --- platform detection (fork-free; set VROOT_PLATFORM to override for tests) --
if [[ -n "${VROOT_PLATFORM:-}" ]]; then
    PLATFORM="$VROOT_PLATFORM"
elif [[ -n "${TERMUX_VERSION:-}" || "${PREFIX:-}" == *com.termux* || -e /system/build.prop ]]; then
    PLATFORM="android"
else
    PLATFORM="linux"
fi
IS_ANDROID=0; [[ "$PLATFORM" == android ]] && IS_ANDROID=1

SELF="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || readlink -f "$0")"
ROOTDIR="$(cd "$(dirname "$SELF")" && pwd)"

# On Android/Termux keep all state inside the app-private data dir so it obeys
# Android storage isolation and SELinux (never /sdcard, /data/local/tmp, etc.).
if [[ -z "${VROOT_HOME:-}" ]]; then
    if [[ "$IS_ANDROID" == 1 && -n "${PREFIX:-}" ]]; then VROOT_HOME="$PREFIX/var/lib/vroot"
    else VROOT_HOME="$HOME/.local/share/vroot"; fi
fi
VROOT_CONFIG="${VROOT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/vroot}"
ENVS_DIR="$VROOT_HOME/envs"
CACHE_DIR="$VROOT_HOME/cache"
BASES_DIR="$CACHE_DIR/.bases"
INST_DIR="$VROOT_HOME/instances"
TMP_DIR="$VROOT_HOME/tmp"
BUILTIN_RECIPES="$ROOTDIR/recipes"
USER_RECIPES="$VROOT_CONFIG/recipes"

ALPINE_VER="3.20.3"
ALPINE_REL="v${ALPINE_VER%.*}"
ALPINE_CDN="https://dl-cdn.alpinelinux.org/alpine"
# Pinned rootfs checksums for the common arches; others verify against the
# CDN-published .sha256 file.
ALPINE_SHA256_X86_64="d4e6fd67dcf75e40c451560ac7265166c2b72a0f38ddc9aae756a7de3d1efa0c"
ALPINE_SHA256_AARCH64="041fa34a81788242df9e78fa69b97ab45b8ec47ddbf88864755610414a7bf3de"
DEBIAN_IMG="debian:bookworm-slim"

IMG_EXT="vroot"
MIME_TYPE="application/x-vroot-image"

# --- engine selection (auto-detected on Android; see overlay_engine) ----------
OVERLAY_ENGINE="${VROOT_OVERLAY:-}"
PRIV_BRIDGE="${VROOT_PRIV_BRIDGE:-}"
PRIV_SU_STYLE="${VROOT_SU_STYLE:-}"
BWRAP_BIN="${VROOT_BWRAP:-bwrap}"
FUSE_OVERLAYFS_BIN="${VROOT_FUSE_OVERLAYFS:-fuse-overlayfs}"
CAPS_FILE="$VROOT_HOME/.caps"
# Linux always uses native overlayfs: pin it at load so the hot path never
# probes or reads a cache file (keeps startup fork-free).
[[ "$IS_ANDROID" == 0 && -z "$OVERLAY_ENGINE" ]] && OVERLAY_ENGINE="native"

RESERVED=" build ls list rm delete save load filetype recipe recipes envs images prune info help version doctor "

C0=$'\033[0m'; CB=$'\033[1;34m'; CG=$'\033[1;32m'; CY=$'\033[1;33m'; CR=$'\033[1;31m'; CD=$'\033[2m'
log()  { printf '%s==>%s %s\n' "$CB" "$C0" "$*" >&2; }
ok()   { printf '%s  ok%s %s\n' "$CG" "$C0" "$*" >&2; }
warn() { printf '%swarn%s %s\n' "$CY" "$C0" "$*" >&2; }
die()  { printf '%serr %s %s\n' "$CR" "$C0" "$*" >&2; exit 1; }
need_cmd() { command -v "$1" >/dev/null 2>&1; }
is_android() { [[ "$IS_ANDROID" == 1 ]]; }

# --- host arch / alpine rootfs helpers ---------------------------------------
alpine_arch() {
    [[ -n "${VROOT_ALPINE_ARCH:-}" ]] && { printf '%s' "$VROOT_ALPINE_ARCH"; return 0; }
    case "$(uname -m 2>/dev/null || echo unknown)" in
        x86_64|amd64)        printf 'x86_64' ;;
        aarch64|arm64)       printf 'aarch64' ;;
        armv7l|armv7)        printf 'armv7' ;;
        armv6l|armv6)        printf 'armv6' ;;
        i386|i486|i586|i686) printf 'x86' ;;
        ppc64le)             printf 'ppc64le' ;;
        s390x)               printf 's390x' ;;
        riscv64)             printf 'riscv64' ;;
        *)                   printf 'x86_64' ;;
    esac
}
alpine_url() { printf '%s/%s/releases/%s/alpine-minirootfs-%s-%s.tar.gz' "$ALPINE_CDN" "$ALPINE_REL" "$1" "$ALPINE_VER" "$1"; }

# --- capability probes --------------------------------------------------------
# Can we create an unprivileged user namespace? (required by bubblewrap)
probe_userns() { unshare --user --map-root-user true 2>/dev/null; }

# Can we mount overlayfs inside an unprivileged user namespace?
probe_native_overlay() {
    local d rc=1
    d="$(mktemp -d "$TMP_DIR/ovl.XXXXXX" 2>/dev/null)" || return 1
    mkdir -p "$d/lower" "$d/upper" "$d/work" "$d/merged" 2>/dev/null || { rm -rf "$d"; return 1; }
    if unshare --user --map-root-user --mount -- /bin/sh -c '
            mount -t overlay overlay -o "lowerdir='"$d"'/lower,upperdir='"$d"'/upper,workdir='"$d"'/work" "'"$d"'/merged" 2>/dev/null || exit 1
            umount "'"$d"'/merged" 2>/dev/null
        ' 2>/dev/null; then rc=0; fi
    rm -rf "$d" 2>/dev/null || true
    return $rc
}

# fuse-overlayfs fallback: needs the binary and a usable /dev/fuse.
probe_fuse() {
    need_cmd "$FUSE_OVERLAYFS_BIN" || return 1
    [[ -r /dev/fuse && -w /dev/fuse ]] || return 1
    return 0
}

probe_tmpfs() {
    local t
    t="$(stat -f -c %T "$TMP_DIR" 2>/dev/null || true)"
    [[ "$t" == tmpfs ]]
}

# Privileged execution bridges (for locked-down OEM kernels with no userns).
# `su` comes in two shapes: Magisk/Lineage (`su -c CMD`) and AOSP/toybox
# (`su UID CMD`). Detect which one is present so we can invoke it correctly.
detect_priv_bridge() {
    [[ -n "$PRIV_BRIDGE" ]] && return 0
    if need_cmd su; then
        PRIV_BRIDGE="su"
        if [[ -z "$PRIV_SU_STYLE" ]]; then
            if su -c true 2>/dev/null; then PRIV_SU_STYLE="flag"
            elif su 0 true 2>/dev/null; then PRIV_SU_STYLE="uid"
            else PRIV_SU_STYLE="flag"; fi
        fi
        return 0
    fi
    if need_cmd ksu;      then PRIV_BRIDGE="ksu";      return 0; fi
    if need_cmd rish;     then PRIV_BRIDGE="shizuku";  return 0; fi
    return 1
}

# Decide how to build the writable root layer. On Linux we trust native; on
# Android we probe, cheapest first: native overlay -> fuse-overlayfs -> root.
detect_engine() {
    if ! is_android; then OVERLAY_ENGINE="native"; return 0; fi
    if probe_userns; then
        if probe_native_overlay; then OVERLAY_ENGINE="native"; return 0; fi
        if probe_fuse;           then OVERLAY_ENGINE="fuse";   return 0; fi
    fi
    # Android blocks userns on most ROMs and blocks overlayfs entirely; if we
    # can reach real root, use the mount-namespace engine instead.
    if [[ "$(id -u 2>/dev/null)" == 0 ]] || detect_priv_bridge; then
        OVERLAY_ENGINE="priv"; return 0
    fi
    OVERLAY_ENGINE="none"; return 0
}

# Resolve the engine in-process (no forks beyond the probes themselves). The
# result is memoized in $OVERLAY_ENGINE and cached in $CAPS_FILE so later runs
# do not probe. `vroot doctor --probe` refreshes the cache.
resolve_engine() {
    [[ -n "$OVERLAY_ENGINE" && "$OVERLAY_ENGINE" != none ]] && return 0
    if [[ -z "$OVERLAY_ENGINE" && -f "$CAPS_FILE" ]]; then
        local k v
        while IFS='=' read -r k v; do
            [[ "$k" == engine ]] && OVERLAY_ENGINE="$v"
            [[ "$k" == bridge && -z "$PRIV_BRIDGE" ]] && PRIV_BRIDGE="$v"
            [[ "$k" == sustyle && -z "$PRIV_SU_STYLE" ]] && PRIV_SU_STYLE="$v"
        done < "$CAPS_FILE"
    fi
    [[ -n "$OVERLAY_ENGINE" && "$OVERLAY_ENGINE" != none ]] && return 0
    detect_engine
    write_caps
    return 0
}

# Print the engine (used by doctor / diagnostics).
overlay_engine() { resolve_engine; printf '%s' "$OVERLAY_ENGINE"; }

write_caps() {
    mkdir -p "$VROOT_HOME" 2>/dev/null || true
    { printf 'engine=%s\n' "${OVERLAY_ENGINE:-}"; printf 'bridge=%s\n' "${PRIV_BRIDGE:-}"; printf 'sustyle=%s\n' "${PRIV_SU_STYLE:-}"; } > "$CAPS_FILE" 2>/dev/null || true
}

fetch() { # URL DEST
    if need_cmd curl; then curl -fLsS -o "$2" "$1"
    elif need_cmd wget; then wget -qO "$2" "$1"
    else die "need curl or wget to download"; fi
}
fetch_sha256() { # ARTIFACT_URL -> prints expected sha256, or nothing
    local out; out="$(mktemp "$TMP_DIR/.sum.XXXXXX" 2>/dev/null)" || return 0
    if fetch "$1.sha256" "$out" 2>/dev/null; then cut -d' ' -f1 "$out" | head -1; fi
    rm -f "$out"
}

# --- squashfs helpers ---------------------------------------------------------
# Linux ships classic squashfs-tools (mksquashfs/unsquashfs); Termux instead
# packages squashfs-tools-ng (gensquashfs/rdsquashfs). Support either.
sqfs_pack_tool()  { for t in mksquashfs gensquashfs tar2sqfs; do need_cmd "$t" && { printf '%s' "$t"; return 0; }; done; return 1; }
sqfs_unpack_tool(){ for t in unsquashfs rdsquashfs; do need_cmd "$t" && { printf '%s' "$t"; return 0; }; done; return 1; }

sqfs_pack() { # DIR OUT
    rm -f "$2"
    case "$(sqfs_pack_tool 2>/dev/null)" in
        mksquashfs)  mksquashfs "$1" "$2" -all-root -comp zstd -noappend -no-progress -quiet >/dev/null 2>&1 ;;
        gensquashfs) gensquashfs --pack-dir "$1" -o "$2" >/dev/null 2>&1 ;;
        tar2sqfs)    ( cd "$1" && tar -cf - . ) | tar2sqfs -q "$2" >/dev/null 2>&1 ;;
        *)           return 1 ;;
    esac
}

sqfs_unpack() { # IMG DEST
    rm -rf "$2"
    mkdir -p "$(dirname "$2")"
    case "$(sqfs_unpack_tool 2>/dev/null)" in
        unsquashfs)  unsquashfs -q -f -d "$2" "$1" >/dev/null 2>&1 ;;
        rdsquashfs)  mkdir -p "$2"; rdsquashfs --unpack-path / --unpack-root "$2" --chmod "$1" >/dev/null 2>&1 ;;
        *)           return 1 ;;
    esac
}

# Path to a bindable resolv.conf. Android ships none, so we synthesise one from
# the system DNS properties (net.dns1/2/3/4) and fall back to public resolvers.
resolv_file() {
    if [[ -r /etc/resolv.conf ]]; then printf '%s' /etc/resolv.conf; return 0; fi
    if is_android; then
        local f="$VROOT_HOME/resolv.conf"
        if [[ ! -s "$f" ]]; then
            mkdir -p "$VROOT_HOME" 2>/dev/null || true
            local prop ns=""
            for prop in net.dns1 net.dns2 net.dns3 net.dns4; do
                local v; v="$(getprop "$prop" 2>/dev/null || true)"
                [[ -n "$v" ]] && ns+="nameserver $v"$'\n'
            done
            [[ -z "$ns" ]] && ns=$'nameserver 8.8.8.8\nnameserver 1.1.1.1\n'
            printf '%s' "$ns" > "$f" 2>/dev/null || true
        fi
        [[ -s "$f" ]] && { printf '%s' "$f"; return 0; }
    fi
    return 1
}

# --- root execution bridges ---------------------------------------------------
# Run a script file as root via whatever privileged bridge is available.
bridge_run() { # SCRIPT_FILE
    case "${PRIV_BRIDGE:-}" in
        su)
            if [[ "${PRIV_SU_STYLE:-flag}" == uid ]]; then su 0 sh "$1"
            else su -c "$1"; fi ;;
        ksu)     ksu -c "$1" ;;
        shizuku) rish -c "$1" ;;
        *)       return 127 ;;
    esac
}

run_privileged() { # execute "$@" as root through the privileged bridge
    local tf; tf="$(mktemp "$TMP_DIR/priv.XXXXXX.sh")" || die "mktemp failed"
    { printf '#!/bin/sh\nset -e\nexec'; printf ' %q' "$@"; printf '\n'; } > "$tf"
    chmod 0755 "$tf"
    local rc=0
    bridge_run "$tf" || rc=$?
    rm -f "$tf"
    [[ $rc == 127 ]] && die "no privileged bridge available (install/allow su, ksu, or Shizuku)"
    return $rc
}

# The root engine runs sandbox processes as root, so files they create inside the
# sandbox are root-owned and the invoking (non-root) user can no longer read or
# delete them. Hand the tree back to the invoking user after each run.
priv_handback() { # DIR
    [[ "$OVERLAY_ENGINE" == priv ]] || return 0
    [[ "$(id -u 2>/dev/null)" == 0 ]] && return 0
    [[ -n "${1:-}" && -d "$1" ]] || return 0
    local cf; cf="$(mktemp "$TMP_DIR/chown.XXXXXX.sh")" || return 0
    printf '#!/bin/sh\nchown -R %s:%s %q\n' "$(id -u)" "$(id -g)" "$1" > "$cf"
    chmod 0755 "$cf"
    bridge_run "$cf" >/dev/null 2>&1 || true
    rm -f "$cf"
}

# --- sandbox root-layer engines ----------------------------------------------
# Each takes the bubblewrap option list (ending in `-- cmd...`) and starts the
# sandbox with the merged root bind-mounted at /.

# Namespace options appropriate to the selected engine. Android permits only
# mount + UTS namespaces for us (user/pid/ipc return EINVAL).
engine_ns_opts() {
    case "$OVERLAY_ENGINE" in
        native|fuse) printf '%s\n' --unshare-pid --unshare-uts --unshare-ipc --unshare-cgroup-try ;;
        priv)        printf '%s\n' --unshare-uts ;;
    esac
}
engine_dev_opts() {
    if [[ "$OVERLAY_ENGINE" == priv ]]; then printf '%s\n' --dev-bind /dev /dev
    else printf '%s\n' --dev /dev; fi
}

spawn_native() {
    export VROOT_LOWER VROOT_UPPER VROOT_WORK VROOT_MERGED VROOT_RAM
    local -a b=( "$BWRAP_BIN" --unshare-user --uid 0 --gid 0 --cap-add ALL "$@" )
    unshare --user --map-root-user --mount -- /bin/sh -c '
        if [ -n "$VROOT_RAM" ]; then mount -t tmpfs none "$VROOT_RAM" || exit 70; fi
        mkdir -p "$VROOT_UPPER" "$VROOT_WORK" "$VROOT_MERGED" || exit 70
        mount -t overlay overlay -o "lowerdir=$VROOT_LOWER,upperdir=$VROOT_UPPER,workdir=$VROOT_WORK" "$VROOT_MERGED" || exit 70
        exec "$@"
    ' sh "${b[@]}"
}

spawn_fuse() {
    export VROOT_LOWER VROOT_UPPER VROOT_WORK VROOT_MERGED VROOT_RAM VROOT_FUSE="$FUSE_OVERLAYFS_BIN"
    local -a b=( "$BWRAP_BIN" --unshare-user --uid 0 --gid 0 --cap-add ALL "$@" )
    unshare --user --map-root-user --mount -- /bin/sh -c '
        if [ -n "$VROOT_RAM" ]; then mount -t tmpfs none "$VROOT_RAM" || exit 70; fi
        mkdir -p "$VROOT_UPPER" "$VROOT_WORK" "$VROOT_MERGED" || exit 70
        "$VROOT_FUSE" -o "lowerdir=$VROOT_LOWER,upperdir=$VROOT_UPPER,workdir=$VROOT_WORK" "$VROOT_MERGED" &
        fp=$!
        n=0; while [ $n -lt 250 ]; do grep -qs " $VROOT_MERGED " /proc/mounts && break; n=$((n+1)); sleep 0.02; done
        "$@"; rc=$?
        fusermount -u "$VROOT_MERGED" 2>/dev/null || fusermount3 -u "$VROOT_MERGED" 2>/dev/null || true
        wait $fp 2>/dev/null
        exit $rc
    ' sh "${b[@]}"
}

spawn_priv() {
    # Real-root mount-namespace engine. Android blocks user/pid/ipc namespaces
    # (EINVAL) and overlayfs even as root, so launch() seeds a writable root
    # directory and we isolate only the mount and UTS namespaces via bubblewrap.
    local bwrap; bwrap="$(command -v "$BWRAP_BIN" 2>/dev/null || printf '%s' "$BWRAP_BIN")"
    if [[ "$(id -u 2>/dev/null)" == 0 ]]; then
        "$bwrap" "$@"
        return $?
    fi
    local tf; tf="$(mktemp "$TMP_DIR/priv.XXXXXX.sh")" || die "mktemp failed"
    { printf '#!/bin/sh\nset -e\nexec'; printf ' %q' "$bwrap" "$@"; printf '\n'; } > "$tf"
    chmod 0755 "$tf"
    local rc=0
    bridge_run "$tf" || rc=$?
    rm -f "$tf"
    [[ $rc == 127 ]] && die "no privileged bridge available (install/allow su, ksu, or Shizuku)"
    return $rc
}

spawn_sandbox() {
    resolve_engine
    case "$OVERLAY_ENGINE" in
        native) spawn_native "$@" ;;
        fuse)   spawn_fuse "$@" ;;
        priv)   spawn_priv "$@" ;;
        *)      die "no usable sandbox engine on this system; run: vroot doctor --probe" ;;
    esac
}

ensure_dirs() {
    [[ -d "$ENVS_DIR" && -d "$CACHE_DIR" && -d "$BASES_DIR" && -d "$INST_DIR" && -d "$TMP_DIR" ]] && return 0
    mkdir -p "$ENVS_DIR" "$CACHE_DIR" "$BASES_DIR" "$INST_DIR" "$TMP_DIR"
}

valid_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
    [[ "$RESERVED" == *" $1 "* ]] && return 1
    return 0
}

rget() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -1; }
rall() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1"; }

# parse_recipe FILE -- read one recipe into R_* globals with no forked helpers.
parse_recipe() {
    local f="$1" line key val
    R_NAME="${f##*/}"; R_NAME="${R_NAME%.conf}"
    R_PROVIDES=""; R_BASE=""; R_PACKAGES=(); R_SETUP=(); R_ENV=""; R_PATH=""; R_VERIFY=(); R_DESC=""; R_DOCS=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        line="${line#"${line%%[![:space:]]*}"}"
        key="${line%%=*}"; [[ "$key" == "$line" ]] && continue
        key="${key%"${key##*[![:space:]]}"}"
        val="${line#*=}"; val="${val#"${val%%[![:space:]]*}"}"
        case "$key" in
            name)        R_NAME="$val" ;;
            provides)    R_PROVIDES="$val" ;;
            base)        R_BASE="$val" ;;
            packages)    R_PACKAGES+=("$val") ;;
            setup)       R_SETUP+=("$val") ;;
            env)         R_ENV="$val" ;;
            path)        R_PATH="$val" ;;
            verify)      R_VERIFY+=("$val") ;;
            description) R_DESC="$val" ;;
            docs)        R_DOCS="$val" ;;
        esac
    done < "$f"
    R_BASE="${R_BASE:-alpine}"
    R_PROVIDES="${R_PROVIDES:-$R_NAME}"
}

RESOLVED_FILE=""
# recipe_file_for FLAG -- resolve a flag/alias to a recipe file (lazy, memoized).
# Sets RESOLVED_FILE and returns 0, or returns 1 if unknown.
recipe_file_for() {
    local flag="$1" g f=""
    if [[ -n "${RECIPE_FILE[$flag]:-}" ]]; then RESOLVED_FILE="${RECIPE_FILE[$flag]}"; return 0; fi
    [[ -f "$USER_RECIPES/$flag.conf" ]] && f="$USER_RECIPES/$flag.conf"
    if [[ -z "$f" ]]; then
        for g in "$USER_RECIPES"/*.conf; do
            [[ -f "$g" ]] || continue
            parse_recipe "$g"
            [[ ",${R_PROVIDES// /}," == *",$flag,"* ]] && f="$g"
        done
    fi
    [[ -z "$f" && -f "$BUILTIN_RECIPES/$flag.conf" ]] && f="$BUILTIN_RECIPES/$flag.conf"
    if [[ -z "$f" ]]; then
        for g in "$BUILTIN_RECIPES"/*.conf; do
            [[ -f "$g" ]] || continue
            parse_recipe "$g"
            [[ ",${R_PROVIDES// /}," == *",$flag,"* ]] && f="$g"
        done
    fi
    [[ -n "$f" ]] || return 1
    RECIPE_FILE["$flag"]="$f"; RESOLVED_FILE="$f"
    return 0
}

meta_get() { [[ -f "$1" ]] && sed -n "s/^$2=//p" "$1" | head -1 || true; }
fsize() { du -sh "$1" 2>/dev/null | cut -f1 || true; }
meta_set() { local f="$1"; shift; : > "$f"; local kv; for kv in "$@"; do printf '%s\n' "$kv" >> "$f"; done; }

declare -A RECIPE_FILE
declare -A RECIPE_DESC

load_recipes() {
    RECIPE_FILE=(); RECIPE_DESC=()
    local dir f p
    for dir in "$BUILTIN_RECIPES" "$USER_RECIPES"; do
        [[ -d "$dir" ]] || continue
        for f in "$dir"/*.conf; do
            [[ -f "$f" ]] || continue
            parse_recipe "$f"
            RECIPE_FILE["$R_NAME"]="$f"
            for p in ${R_PROVIDES//,/ }; do RECIPE_FILE["$p"]="$f"; done
            RECIPE_DESC["$R_NAME"]="$R_DESC"
        done
    done
}

ensure_base() {
    local base="$1" dest="$BASES_DIR/$base" marker="$BASES_DIR/.${base}.ready"
    [[ -f "$marker" && -d "$dest" ]] && return 0
    rm -rf "$dest"; mkdir -p "$dest"
    case "$base" in
        alpine)
            local arch url want
            arch="$(alpine_arch)"; url="$(alpine_url "$arch")"
            log "fetching Alpine $ALPINE_VER ($arch) base rootfs ..."
            local tb; tb="$(mktemp "$TMP_DIR/.alpine.XXXXXX.tar.gz")"
            fetch "$url" "$tb" || { rm -f "$tb"; die "download failed"; }
            case "$arch" in
                x86_64)  want="$ALPINE_SHA256_X86_64" ;;
                aarch64) want="$ALPINE_SHA256_AARCH64" ;;
                *)       want="$(fetch_sha256 "$url")" ;;
            esac
            if [[ -n "$want" ]]; then
                local got; got="$(sha256sum "$tb" | cut -d' ' -f1)"
                [[ "$got" == "$want" ]] || { rm -f "$tb"; die "base rootfs checksum mismatch (expected $want, got $got)"; }
            else
                warn "no published checksum for alpine/$arch; skipping verification"
            fi
            tar -xzf "$tb" -C "$dest" || { rm -f "$tb"; die "extract failed"; }
            rm -f "$tb"
            ;;
        debian)
            need_cmd docker || die "the Debian base needs docker (unavailable on Android/Termux); use an Alpine-based recipe"
            log "fetching Debian base ('$DEBIAN_IMG') via docker ..."
            local cid
            cid="$(docker create "$DEBIAN_IMG")" || die "docker create failed"
            docker export "$cid" | tar -x -C "$dest" || { docker rm -f "$cid" >/dev/null 2>&1; die "export failed"; }
            docker rm "$cid" >/dev/null 2>&1 || true
            ;;
        *) die "unknown base '$base' (use alpine or debian)" ;;
    esac
    : > "$marker"
}

run_in_root() {
    local dir="$1" script="$2"
    resolve_engine
    local -a b=()
    if [[ "$OVERLAY_ENGINE" == priv ]]; then
        b+=(--unshare-uts)
    else
        b+=(--unshare-user --uid 0 --gid 0 --cap-add ALL
            --unshare-pid --unshare-uts --unshare-ipc --unshare-cgroup-try)
    fi
    b+=(--die-with-parent --bind "$dir" / --proc /proc)
    if [[ "$OVERLAY_ENGINE" == priv ]]; then b+=(--dev-bind /dev /dev); else b+=(--dev /dev); fi
    b+=(--tmpfs /tmp --tmpfs /run --ro-bind-try /sys /sys --hostname builder)
    local rf; rf="$(resolv_file 2>/dev/null || true)"
    [[ -n "$rf" ]] && b+=(--ro-bind-try "$rf" /etc/resolv.conf)
    b+=(--setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        -- /bin/sh -c "$script")
    if [[ "$OVERLAY_ENGINE" == priv ]]; then
        spawn_priv "${b[@]}"
    else
        "$BWRAP_BIN" "${b[@]}"
    fi
}

build_env() {
    ensure_dirs
    local flags=("$@"); [[ ${#flags[@]} -eq 0 ]] && flags=(base)

    local -a rfiles=()
    local -A _rseen=()
    local f flag
    for flag in "${flags[@]}"; do
        recipe_file_for "$flag" || die "unknown flag -$flag (no recipe). Try: vroot recipe list"
        f="$RESOLVED_FILE"
        [[ -n "${_rseen[$f]:-}" ]] && continue
        _rseen[$f]=1
        rfiles+=("$f")
    done
    [[ ${#rfiles[@]} -gt 0 ]] || die "no recipes resolved"

    local base="alpine"
    local -a names=()
    for f in "${rfiles[@]}"; do
        parse_recipe "$f"
        names+=("$R_NAME")
        [[ "$R_BASE" == debian ]] && base="debian"
    done

    local slug; local IFS='+'; slug="${names[*]}"; unset IFS

    local hash
    hash="$( { for f in "${rfiles[@]}"; do cat "$f"; done; echo "base=$base"; } | sha256sum | cut -c1-10 )"

    local envfile="$ENVS_DIR/${slug}-${hash}.sqfs"
    if [[ -f "$envfile" ]]; then printf '%s\n' "$envfile"; return 0; fi

    local packages="" setup="" envs="" paths="" verify="" p
    local -a pkgs=(); local -A pseen=()
    for f in "${rfiles[@]}"; do
        parse_recipe "$f"
        if ((${#R_PACKAGES[@]})); then for p in "${R_PACKAGES[@]}"; do [[ -n "$p" ]] && packages+=" $p"; done; fi
        if ((${#R_SETUP[@]}));    then for p in "${R_SETUP[@]}";    do [[ -n "$p" ]] && setup+="$p"$'\n'; done; fi
        [[ -n "$R_ENV" ]]  && envs+="${R_ENV//,/ }"$'\n'
        [[ -n "$R_PATH" ]] && paths+="${R_PATH}:"$'\n'
        if ((${#R_VERIFY[@]}));   then for p in "${R_VERIFY[@]}";   do [[ -n "$p" ]] && verify+="$p"$'\n'; done; fi
    done
    for p in $packages; do [[ -n "${pseen[$p]:-}" ]] && continue; pseen[$p]=1; pkgs+=("$p"); done
    packages="${pkgs[*]}"
    paths="${paths%$'\n'}"; paths="${paths//$'\n'/}"; paths="${paths%:}"

    ensure_base "$base"
    log "building env '$slug' (base=$base) ..."
    local tmp; tmp="$(mktemp -d "$TMP_DIR/build.XXXXXX")"
    cp -a "$BASES_DIR/$base/." "$tmp/"
    mkdir -p "$tmp/proc" "$tmp/sys" "$tmp/dev" "$tmp/tmp" "$tmp/run" "$tmp/root" "$tmp/etc/vroot"
    chmod 1777 "$tmp/tmp" 2>/dev/null || true
    local rf; rf="$(resolv_file 2>/dev/null || true)"
    [[ -n "$rf" ]] && cp "$rf" "$tmp/etc/resolv.conf" 2>/dev/null || true

    case "$base" in
        alpine)
            printf '%s\n' \
                "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VER%.*}/main" \
                "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VER%.*}/community" \
                > "$tmp/etc/apk/repositories"
            ;;
        debian)
            printf 'deb http://deb.debian.org/debian bookworm main\ndeb http://deb.debian.org/debian bookworm-updates main\n' \
                > "$tmp/etc/apt/sources.list"
            ;;
    esac

    {
        if [[ -n "$paths" ]]; then
            printf 'export PATH=%s:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' "$paths"
        else
            printf 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n'
        fi
        [[ -n "$envs" ]] && printf '%s\n' "$envs"
    } > "$tmp/etc/vroot/env"

    printf '\n[ -r /etc/vroot/env ] && . /etc/vroot/env\n' >> "$tmp/etc/profile"

    local script=""
    script+="set -e"$'\n'
    if [[ -n "$packages" ]]; then
        case "$base" in
            alpine) script+="apk update"$'\n'"apk add --no-cache $packages"$'\n' ;;
            debian) script+="export DEBIAN_FRONTEND=noninteractive"$'\n'"apt-get update"$'\n'"apt-get install -y --no-install-recommends $packages"$'\n' ;;
        esac
    fi
    [[ -n "$setup" ]]  && script+="$setup"
    [[ -n "$verify" ]] && script+="$verify"

    if ! run_in_root "$tmp" "$script" 1>&2; then
        rm -rf "$tmp"
        die "build failed for env '$slug'"
    fi
    priv_handback "$tmp"

    sqfs_pack "$tmp" "$envfile" \
        || { rm -rf "$tmp"; die "squashfs packing failed (install squashfs-tools or squashfs-tools-ng)"; }
    rm -rf "$tmp"
    ok "built env '$slug' -> $envfile ($(fsize "$envfile"))"
    printf '%s\n' "$envfile"
}

ensure_cache() {
    local envfile="$1"
    local cache="$2"
    local marker="$CACHE_DIR/.${cache##*/}.ready"
    if [[ -f "$marker" && -d "$cache" ]]; then return 0; fi
    mkdir -p "$CACHE_DIR"
    rm -rf "$cache"
    sqfs_unpack "$envfile" "$cache" || die "cannot unpack env image: $envfile"
    : > "$marker"
}

O_FLAGS=(); O_ENV=(); O_VOLUMES=(); O_CMD=()
O_OFFLINE=0; O_CLEAN=0; O_KEEP=0; O_RM=0
O_NAME=""; O_HOSTNAME=""; O_CWD=""; O_ENVFILE=""

parse_args() {
    O_FLAGS=(); O_ENV=(); O_VOLUMES=(); O_CMD=()
    O_OFFLINE=0; O_CLEAN=0; O_KEEP=0; O_RM=0
    O_NAME=""; O_HOSTNAME=""; O_CWD=""; O_ENVFILE=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; O_CMD=("$@"); break ;;
            -offline|--offline|-o) O_OFFLINE=1; shift ;;
            -net|--net) O_OFFLINE=0; shift ;;
            -clean|--clean) O_CLEAN=1; shift ;;
            -keep|--keep|-k) O_KEEP=1; shift ;;
            -rm|--rm) O_RM=1; shift ;;
            -v|--volume) O_VOLUMES+=("${2:?use -v SRC[:DST][:ro]}"); shift 2 ;;
            -v=*|--volume=*) O_VOLUMES+=("${1#*=}"); shift ;;
            -env|--env) O_ENV+=("${2:?use -env K=V}"); shift 2 ;;
            -env=*|--env=*) O_ENV+=("${1#*=}"); shift ;;
            -cwd|--cwd) O_CWD="${2:?use -cwd DIR}"; shift 2 ;;
            -cwd=*|--cwd=*) O_CWD="${1#*=}"; shift ;;
            -name|--name) O_NAME="${2:?use -name NAME}"; shift 2 ;;
            -name=*|--name=*) O_NAME="${1#*=}"; shift ;;
            -hostname|--hostname) O_HOSTNAME="${2:?}"; shift 2 ;;
            -hostname=*|--hostname=*) O_HOSTNAME="${1#*=}"; shift ;;
            -h|--help) O_NAME="__help__"; shift ;;
            -*) local fl="${1#-}"; fl="${fl#-}"
                if recipe_file_for "$fl"; then O_FLAGS+=("$fl"); else die "unknown flag -$fl (try: vroot recipe list)"; fi
                shift ;;
            *.sqfs|*.vroot) [[ -f "$1" ]] || die "no such image file: $1"; O_ENVFILE="$1"; shift ;;
            */*)    [[ -f "$1" ]] || die "not a sandbox name or file: $1"; O_ENVFILE="$1"; shift ;;
            *) [[ -z "$O_NAME" ]] || die "unexpected argument: $1"; O_NAME="$1"; shift ;;
        esac
    done
}

launch() {
    local envfile="$1" name="${2:-}"
    local cname cache
    cname="${envfile##*/}"; cname="${cname%.vroot}"; cname="${cname%.sqfs}"
    cache="$CACHE_DIR/$cname"
    ensure_cache "$envfile" "$cache"
    resolve_engine

    local upper work merged ram base idir ephem=0 uses_overlay=0
    case "$OVERLAY_ENGINE" in native|fuse) uses_overlay=1 ;; esac

    if [[ $uses_overlay == 1 ]]; then
        if [[ -n "$name" ]]; then
            valid_name "$name" || die "invalid sandbox name: '$name'"
            idir="$INST_DIR/$name"
            if [[ ! -d "$idir" ]]; then
                mkdir -p "$idir"
                meta_set "$idir/meta" "ENV=$cname" "CREATED=$(date -Is)"
            fi
            upper="$idir/upper"; work="$idir/work"; merged="$idir/.merged"
            mkdir -p "$upper" "$work" "$merged"
            rm -rf "$work"/* 2>/dev/null || true
            ram=""
        else
            base="$(mktemp -d "$TMP_DIR/run.XXXXXX")"; ephem=1
            ram="$base/ram"; mkdir -p "$ram"; upper="$ram/upper"; work="$ram/work"; merged="$ram/merged"
        fi
        export VROOT_LOWER="$cache" VROOT_UPPER="$upper" VROOT_WORK="$work" VROOT_MERGED="$merged" VROOT_RAM="$ram"
    else
        # priv / root engine: Android blocks overlayfs even as root, so seed a
        # real writable root directory from the read-only cache instead.
        if [[ -n "$name" ]]; then
            valid_name "$name" || die "invalid sandbox name: '$name'"
            idir="$INST_DIR/$name"
            if [[ ! -d "$idir" ]]; then
                mkdir -p "$idir"
                meta_set "$idir/meta" "ENV=$cname" "CREATED=$(date -Is)"
            fi
            if [[ ! -f "$idir/.seeded" ]]; then
                rm -rf "$idir/root"; mkdir -p "$idir/root"
                cp -a "$cache/." "$idir/root/" || die "failed to seed sandbox '$name'"
                : > "$idir/.seeded"
            fi
            merged="$idir/root"
        else
            base="$(mktemp -d "$TMP_DIR/run.XXXXXX")"; ephem=1
            merged="$base/root"; mkdir -p "$merged"
            cp -a "$cache/." "$merged/" || die "failed to seed sandbox"
        fi
        ram=""
        export VROOT_LOWER="" VROOT_UPPER="" VROOT_WORK="" VROOT_MERGED="$merged" VROOT_RAM=""
    fi

    local host="${O_HOSTNAME:-${name:-vroot}}"
    local cwd="${O_CWD:-/root}"

    local -a ns=(); mapfile -t ns < <(engine_ns_opts)
    local -a dev=(); mapfile -t dev < <(engine_dev_opts)
    local -a bargs=( "${ns[@]}" --die-with-parent
        --bind "$merged" / --proc /proc "${dev[@]}" --tmpfs /tmp --tmpfs /run
        --ro-bind-try /sys /sys --hostname "$host" --chdir "$cwd" )
    local rf; rf="$(resolv_file 2>/dev/null || true)"
    [[ -n "$rf" ]] && bargs+=(--ro-bind-try "$rf" /etc/resolv.conf)
    [[ "$O_OFFLINE" == 1 ]] && bargs+=(--unshare-net)
    [[ "$O_CLEAN" == 1 ]] && bargs+=(--clearenv)
    bargs+=(--setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin)
    bargs+=(--setenv HOME /root)
    bargs+=(--setenv VROOT_ENV "$cname")
    bargs+=(--setenv TERM "${TERM:-xterm-256color}")

    local e
    for e in "${O_ENV[@]}"; do bargs+=(--setenv "${e%%=*}" "${e#*=}"); done

    local v src dst mode
    for v in "${O_VOLUMES[@]}"; do
        src="${v%%:*}"; dst="${v#*:}"; mode="rw"
        if [[ "$dst" == *:* ]]; then mode="${dst##*:}"; dst="${dst%:*}"; fi
        [[ "$dst" == "$v" || -z "$dst" ]] && dst="$src"
        case "$dst" in /*) ;; *) dst="/$dst" ;; esac
        case "$src" in /*) ;; *) src="$PWD/$src" ;; esac
        case "$mode" in
            ro) bargs+=(--ro-bind-try "$src" "$dst") ;;
            rw) bargs+=(--bind-try "$src" "$dst") ;;
            *)  die "bad -v mode '$mode' (use :ro)" ;;
        esac
    done

    local -a cmd=("${O_CMD[@]}")
    [[ ${#cmd[@]} -eq 0 ]] && cmd=(/bin/sh -l)
    bargs+=(-- "${cmd[@]}")

    spawn_sandbox "${bargs[@]}"
    local rc=$?
    if [[ -n "$name" ]]; then priv_handback "$idir"; else priv_handback "$base"; fi
    [[ $ephem == 1 && -n "$base" ]] && rm -rf "$base"
    [[ "$O_RM" == 1 && -n "$name" ]] && rm_instance "$name"
    return $rc
}

rm_instance() {
    local name="$1"
    local idir="$INST_DIR/$name"
    [[ -d "$idir" ]] || { warn "no such sandbox: $name"; return 0; }
    chmod -R u+rwX "$idir" 2>/dev/null || true
    if ! rm -rf "$idir" 2>/dev/null; then
        # Some files may be root-owned (created by the root engine); escalate.
        local cf; cf="$(mktemp "$TMP_DIR/rm.XXXXXX.sh")" || { warn "cannot remove sandbox '$name'"; return 1; }
        printf '#!/bin/sh\nrm -rf %q\n' "$idir" > "$cf"
        chmod 0755 "$cf"; bridge_run "$cf" >/dev/null 2>&1 || true; rm -f "$cf"
    fi
    ok "removed sandbox '$name'"
}

cmd_run() {
    parse_args "$@"
    [[ "$O_NAME" == "__help__" ]] && { cmd_help; return 0; }

    local envfile name="$O_NAME"
    if [[ -n "$O_ENVFILE" ]]; then
        envfile="$(readlink -f "$O_ENVFILE")"
    elif [[ ${#O_FLAGS[@]} -gt 0 ]]; then
        envfile="$(build_env "${O_FLAGS[@]}")" || exit 1
    elif [[ -n "$name" && -f "$INST_DIR/$name/meta" ]]; then
        envfile="$ENVS_DIR/$(meta_get "$INST_DIR/$name/meta" ENV).sqfs"
    else
        envfile="$(build_env base)" || exit 1
    fi

    if [[ -n "$name" && -f "$INST_DIR/$name/meta" ]]; then
        local cur; cur="$(meta_get "$INST_DIR/$name/meta" ENV)"
        local curname="${envfile##*/}"; curname="${curname%.vroot}"; curname="${curname%.sqfs}"
        if [[ "$curname" != "$cur" ]]; then
            die "sandbox '$name' already uses env '$cur'; use another name or 'vroot rm $name'"
        fi
    fi

    launch "$envfile" "$name"
}

cmd_build() {
    parse_args "$@"
    local envfile
    if [[ ${#O_FLAGS[@]} -gt 0 ]]; then envfile="$(build_env "${O_FLAGS[@]}")"; else envfile="$(build_env base)"; fi
    ok "env file: $envfile"
}

cmd_ls() {
    ensure_dirs
    printf '%s%-22s %-26s %-6s %s%s\n' "$CB" SANDBOX ENV SIZE AGE "$C0"
    local found=0 n idir env sz cre age t
    for idir in "$INST_DIR"/*; do
        [[ -d "$idir" ]] || continue
        found=1; n="$(basename "$idir")"
        env="$(meta_get "$idir/meta" ENV)"; cre="$(meta_get "$idir/meta" CREATED)"
        sz="$(fsize "$idir")"
        age="-"
        if [[ -n "$cre" ]]; then t=$(date -d "$cre" +%s 2>/dev/null || echo 0); [[ $t -gt 0 ]] && age="$(( ($(date +%s)-t)/60 ))m"; fi
        printf '%-22s %-26s %-6s %s\n' "$n" "${env:--}" "${sz:--}" "$age"
    done
    [[ $found == 1 ]] || printf '  %s(no sandboxes yet - try: vroot -python)%s\n' "$CD" "$C0"
}

cmd_rm() {
    ensure_dirs
    local all=0 chats=0 names=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a) all=1; shift ;;
            *) names+=("$1"); shift ;;
        esac
    done
    if [[ $all == 1 ]]; then
        local d; for d in "$INST_DIR"/*; do [[ -d "$d" ]] && names+=("$(basename "$d")"); done
    fi
    [[ ${#names[@]} -gt 0 ]] || die "usage: vroot rm NAME... | --all"
    local n; for n in "${names[@]}"; do rm_instance "$n"; done
}

cmd_envs() {
    ensure_dirs
    printf '%s%-40s %-8s %s%s\n' "$CB" "ENV IMAGE" SIZE "$C0"
    local found=0 f
    for f in "$ENVS_DIR"/*.sqfs; do
        [[ -f "$f" ]] || continue
        found=1
        printf '%-40s %-8s\n' "$(basename "$f")" "$(fsize "$f")"
    done
    [[ $found == 1 ]] || printf '  %s(no env images yet - try: vroot -python)%s\n' "$CD" "$C0"
    printf '\n%sbase rootfs cache:%s\n' "$CD" "$C0"
    for f in "$BASES_DIR"/*; do [[ -d "$f" ]] && printf '  %-10s %s\n' "$(basename "$f")" "$(fsize "$f")"; done
    return 0
}

cmd_prune() {
    ensure_dirs
    local f cname
    for f in "$CACHE_DIR"/*; do
        [[ -d "$f" ]] || continue
        [[ "$(basename "$f")" == .bases ]] && continue
        cname="$(basename "$f")"
        if [[ ! -f "$ENVS_DIR/$cname.sqfs" ]]; then
            rm -rf "$f" "$CACHE_DIR/.$cname.ready"
            ok "pruned cache '$cname'"
        fi
    done
    for f in "$TMP_DIR"/*; do [[ -e "$f" ]] && rm -rf "$f"; done
}

cmd_info() {
    local name="${1:-}"; [[ -n "$name" ]] || die "usage: vroot info NAME"
    local idir="$INST_DIR/$name"; [[ -d "$idir" ]] || die "no such sandbox: $name"
    printf '%ssandbox%s %s\n' "$CB" "$C0" "$name"
    printf '  env:     %s\n' "$(meta_get "$idir/meta" ENV)"
    printf '  created: %s\n' "$(meta_get "$idir/meta" CREATED)"
    printf '  size:    %s\n' "$(fsize "$idir")"
    printf '  path:    %s\n' "$idir"
    if [[ -d "$idir/upper" ]]; then
        printf '  changed: %s files in upper layer\n' "$(find "$idir/upper" -mindepth 1 2>/dev/null | wc -l || true)"
    else
        printf '  writable root: %s\n' "$idir/root"
    fi
}

cmd_save() {
    local name="${1:-}" out="${2:-}"
    [[ -n "$name" ]] || die "usage: vroot save NAME [OUT.$IMG_EXT]"
    local idir="$INST_DIR/$name"; [[ -d "$idir" ]] || die "no such sandbox: $name"
    out="${out:-$PWD/$name.$IMG_EXT}"
    local envfile="$ENVS_DIR/$(meta_get "$idir/meta" ENV).sqfs"
    [[ -f "$envfile" ]] || die "env image missing"
    local envcname="${envfile##*/}"; envcname="${envcname%.sqfs}"
    local cache="$CACHE_DIR/$envcname"
    ensure_cache "$envfile" "$cache"
    log "packing sandbox '$name' -> $out ..."
    if [[ -d "$idir/root" ]]; then
        sqfs_pack "$idir/root" "$out" || die "pack failed"
    else
        local upper="$idir/upper" work="$idir/work" merged="$idir/.merged"
        mkdir -p "$work" "$merged"
        export VROOT_LOWER="$cache" VROOT_UPPER="$upper" VROOT_WORK="$work" VROOT_MERGED="$merged"
        unshare --user --map-root-user --mount -- /bin/sh -c '
            mount -t overlay overlay -o "lowerdir=$VROOT_LOWER,upperdir=$VROOT_UPPER,workdir=$VROOT_WORK" "$VROOT_MERGED" || exit 70
            if command -v mksquashfs >/dev/null; then
                exec mksquashfs "$VROOT_MERGED" "$1" -all-root -comp zstd -noappend -no-progress -quiet
            elif command -v gensquashfs >/dev/null; then
                exec gensquashfs --pack-dir "$VROOT_MERGED" -o "$1"
            else
                cd "$VROOT_MERGED" && exec tar -cf - . | tar2sqfs -q "$1"
            fi
        ' sh "$out" >/dev/null 2>&1 || die "pack failed"
    fi
    ok "saved -> $out ($(fsize "$out"))"
}

cmd_recipe() {
    load_recipes
    local sub="${1:-list}"; shift 2>/dev/null || true
    case "$sub" in
        list)
            printf '%s%-12s %-32s %-7s %s%s\n' "$CB" FLAG PROVIDES BASE DESC "$C0"
            local f name prov base desc
            for f in "$BUILTIN_RECIPES"/*.conf "$USER_RECIPES"/*.conf; do
                [[ -f "$f" ]] || continue
                name="$(basename "$f" .conf)"; prov="$(rget "$f" provides)"; base="$(rget "$f" base)"
                desc="$(rget "$f" description)"
                printf '%-12s %-32s %-7s %s\n' "$name" "${prov:-$name}" "${base:-alpine}" "$desc"
            done ;;
        show) local n="${1:?usage: vroot recipe show NAME}"; cat "${RECIPE_FILE[$n]:?no recipe '$n'}" ;;
        path) printf 'built-in: %s\nuser:     %s\n' "$BUILTIN_RECIPES" "$USER_RECIPES" ;;
        edit) local n="${1:?usage: vroot recipe edit NAME}"; "${EDITOR:-nano}" "${RECIPE_FILE[$n]:?no recipe '$n'}" ;;
        new)
            local n="${1:?usage: vroot recipe new NAME}"
            mkdir -p "$USER_RECIPES"
            local dst="$USER_RECIPES/$n.conf"
            [[ -e "$dst" ]] && die "recipe already exists: $dst"
            cat > "$dst" <<TEMPLATE
name = $n
provides = $n
base = alpine
packages =
setup =
env =
path =
verify = command -v $n
description = My $n environment
docs =
TEMPLATE
            ok "created $dst"
            "${EDITOR:-nano}" "$dst" ;;
        *) die "usage: vroot recipe list|show NAME|new NAME|edit NAME|path" ;;
    esac
}

cmd_filetype() {
    local sub="${1:-status}"
    local data="${XDG_DATA_HOME:-$HOME/.local/share}"
    local mime_dir="$data/mime"
    local pkg="$mime_dir/packages/vroot.xml"
    local app_dir="$data/applications"
    local desk="$app_dir/vroot-image.desktop"
    case "$sub" in
        install)
            mkdir -p "$mime_dir/packages" "$app_dir"
            cat > "$pkg" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-vroot-image">
    <comment>vroot sandbox image</comment>
    <icon name="application-x-vroot-image"/>
    <magic priority="60">
      <match type="string" value="hsqs" offset="0"/>
    </magic>
    <glob pattern="*.vroot"/>
    <glob pattern="*.sqfs"/>
  </mime-type>
</mime-info>
XML
            cat > "$desk" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=vroot sandbox image
Comment=Boot a vroot single-file sandbox image
Exec=$SELF %f
Terminal=true
Icon=utilities-terminal
Categories=Development;System;
MimeType=$MIME_TYPE;
EOF
            if need_cmd update-mime-database; then update-mime-database "$mime_dir" >/dev/null 2>&1 || true
            else warn "update-mime-database not found; MIME database not refreshed"; fi
            need_cmd update-desktop-database && update-desktop-database "$app_dir" >/dev/null 2>&1 || true
            ok "file type installed: $MIME_TYPE (*.$IMG_EXT, *.sqfs)"
            ok "mime package: $pkg"
            ok "handler:      $desk"
            ;;
        uninstall)
            rm -f "$pkg" "$desk"
            need_cmd update-mime-database && update-mime-database "$mime_dir" >/dev/null 2>&1 || true
            need_cmd update-desktop-database && update-desktop-database "$app_dir" >/dev/null 2>&1 || true
            ok "file type removed: $MIME_TYPE"
            ;;
        status)
            printf '%svroot file type%s\n' "$CB" "$C0"
            printf '  type:     %s\n' "$MIME_TYPE"
            printf '  globs:    *.%s  *.sqfs\n' "$IMG_EXT"
            printf '  mime:     %s [%s]\n' "$pkg" "$([[ -f "$pkg" ]] && printf present || printf missing)"
            printf '  handler:  %s [%s]\n' "$desk" "$([[ -f "$desk" ]] && printf present || printf missing)"
            if need_cmd xdg-mime; then
                local probe="$TMP_DIR/probe.$IMG_EXT"
                printf 'hsqs' > "$probe" 2>/dev/null || true
                printf '  detected: %s\n' "$(xdg-mime query filetype "$probe" 2>/dev/null || printf '-')"
                rm -f "$probe"
            fi
            ;;
        *) die "usage: vroot filetype [install|uninstall|status]" ;;
    esac
}

pkg_hint() {
    if is_android; then printf 'pkg install %s' "$1"; else printf 'apt install %s' "$1"; fi
}

cmd_doctor() {
    local mode="${1:-}"
    if [[ "$mode" == --probe ]]; then
        [[ -z "${VROOT_OVERLAY:-}" ]] && OVERLAY_ENGINE=""
        PRIV_BRIDGE="${VROOT_PRIV_BRIDGE:-}"
        PRIV_SU_STYLE="${VROOT_SU_STYLE:-}"
        rm -f "$CAPS_FILE"
    fi
    printf '%svroot %s%s\n\n' "$CB" "$VERSION" "$C0"
    printf 'platform: %s%s%s   arch: %s\n\n' "$CB" "$PLATFORM" "$C0" "$(alpine_arch)"

    need_cmd "$BWRAP_BIN" && ok "bwrap: $("$BWRAP_BIN" --version 2>/dev/null || echo present)" || die "bubblewrap missing ($(pkg_hint bubblewrap))"
    need_cmd unshare    && ok "unshare: present"              || die "util-linux unshare missing"
    local pt ut
    pt="$(sqfs_pack_tool 2>/dev/null)" || die "squashfs tools missing ($(pkg_hint squashfs-tools-ng))"
    ut="$(sqfs_unpack_tool 2>/dev/null)" || die "squashfs unpack tool missing ($(pkg_hint squashfs-tools-ng))"
    ok "squashfs: pack=$pt unpack=$ut"

    if is_android; then
        probe_userns && ok "user namespaces: enabled" || warn "user namespaces: DISABLED (kernel/ROM restriction)"
        [[ -e /dev/fuse ]] && ok "/dev/fuse: present" || warn "/dev/fuse: missing (fuse-overlayfs unavailable)"
        need_cmd "$FUSE_OVERLAYFS_BIN" && ok "fuse-overlayfs: present" || warn "fuse-overlayfs: missing"
        probe_tmpfs && ok "tmpfs: available" || warn "tmpfs: not detected"
        if detect_priv_bridge; then ok "privileged bridge: $PRIV_BRIDGE"; else warn "privileged bridge: none (su / ksu / Shizuku)"; fi
        printf '\n'
        local eng; eng="$(overlay_engine)"
        case "$eng" in
            native) ok "engine: native overlayfs (fastest)" ;;
            fuse)   ok "engine: fuse-overlayfs (userspace fallback)" ;;
            priv)   ok "engine: root mount-namespace (no overlay; bridge=${PRIV_BRIDGE:-root})" ;;
            *)      warn "engine: none - sandboxes cannot start; see docs/ANDROID.md" ;;
        esac
    else
        need_cmd busybox && ok "busybox: present" || warn "busybox missing (only for the tiny base)"
        need_cmd docker  && ok "docker: $(docker --version | cut -d, -f1)" || warn "docker missing (only for the Debian base)"
        local out
        out="$(unshare --user --map-root-user --mount -- sh -c '
            d=$(mktemp -d); mkdir -p "$d/u" "$d/w" "$d/m" "$d/l"
            mount -t overlay overlay -o "lowerdir=$d/l,upperdir=$d/u,workdir=$d/w" "$d/m" 2>/dev/null && echo yes || echo no
            umount "$d/m" 2>/dev/null || true
            rm -rf "$d"' 2>/dev/null || true)"
        [[ "$out" == yes ]] && ok "unprivileged overlayfs: supported (copy-on-write sandboxes)" || warn "overlayfs not available in userns"
    fi

    printf '\n'
    cmd_envs

    case "$mode" in
        --probe) resolve_engine; write_caps; ok "capabilities cached (engine=$OVERLAY_ENGINE)" ;;
        --test-android|--test) printf '\n'; test_android ;;
    esac
}

test_android() {
    printf '%sAndroid self-test%s\n\n' "$CB" "$C0"
    local fails=0 out rc eng
    OVERLAY_ENGINE=""; eng="$(overlay_engine)"
    if [[ "$eng" == none ]]; then
        printf '  %sFAIL%s no usable sandbox engine (see doctor above)\n' "$CR" "$C0"
        return 1
    fi
    printf '  %s ok %s engine selected: %s\n' "$CG" "$C0" "$eng"

    [[ -d "$BASES_DIR/alpine" ]] || printf '  %s .. %s building Alpine base (needs network)\n' "$CD" "$C0"
    local -a V=("${BASH:-bash}" "$SELF")

    out="$("${V[@]}" -base -offline -- sh -c 'printf "uid=%s arch=%s ok=1\n" "$(id -u)" "$(uname -m)"' 2>&1)"; rc=$?
    if [[ $rc == 0 && "$out" == *uid=0* && "$out" == *ok=1* ]]; then
        printf '  %s ok %s root shell: %s\n' "$CG" "$C0" "$(printf '%s' "$out" | tr '\n' ' ')"
    else
        printf '  %sFAIL%s root shell: rc=%s out=%s\n' "$CR" "$C0" "$rc" "$out"; fails=$((fails+1))
    fi

    out="$("${V[@]}" -base -offline -- sh -c 'echo hi > /root/.vroot-wtest && cat /root/.vroot-wtest' 2>&1)"; rc=$?
    if [[ $rc == 0 && "$out" == *hi* ]]; then
        printf '  %s ok %s writable root\n' "$CG" "$C0"
    else
        printf '  %sFAIL%s writable root: rc=%s out=%s\n' "$CR" "$C0" "$rc" "$out"; fails=$((fails+1))
    fi

    "${V[@]}" rm vrselftest >/dev/null 2>&1 || true
    "${V[@]}" -base -offline vrselftest -- sh -c 'echo persisted > /root/marker' >/dev/null 2>&1
    out="$("${V[@]}" -base -offline vrselftest -- sh -c 'cat /root/marker' 2>&1)"; rc=$?
    if [[ $rc == 0 && "$out" == *persisted* ]]; then
        printf '  %s ok %s persistence across sessions\n' "$CG" "$C0"
    else
        printf '  %sFAIL%s persistence: rc=%s out=%s\n' "$CR" "$C0" "$rc" "$out"; fails=$((fails+1))
    fi
    "${V[@]}" rm vrselftest >/dev/null 2>&1 || true

    printf '\n'
    if [[ $fails == 0 ]]; then ok "self-test passed"; else warn "self-test: $fails check(s) failed"; fi
    return "$fails"
}

cmd_banner() {
    printf '%s' "$CB"
    cat <<'ART'

 __   __  ____   ___   ___  _____
 \ \ / / |  _ \ / _ \ / _ \ |_   _|
  \ V /  | |_) | | | | | | | |   | |
   | |   |  _ < | |_| | | |_| |  | |
   |_|   |_| \_\ \___/ \___/    |_|
ART
    printf '%s' "$C0"
    printf '  %svroot %s%s — a root shell in a sandbox, built from a flag.\n\n' "$CD" "$VERSION" "$C0"
    printf '  %sInstant, isolated, single-file Linux environments. No daemon, no sudo.%s\n\n' "$CD" "$C0"

    printf '%sGETTING STARTED%s\n' "$CB" "$C0"
    printf '  %-34s %s\n' 'vroot -python' 'a root shell with Python'
    printf '  %-34s %s\n' 'vroot -node -python' 'compose flags freely'
    printf '  %-34s %s\n' 'vroot -sqlite -python db' 'a persistent sandbox named "db"'
    printf '  %-34s %s\n' 'vroot -rust -- cargo build' 'run one command, not a shell'
    printf '  %-34s %s\n' 'vroot -python -offline' 'a sandbox with no network'
    printf '\n'
    printf '%sMORE%s\n' "$CB" "$C0"
    printf '  %-34s %s\n' 'vroot help' 'full help and all options'
    printf '  %-34s %s\n' 'vroot recipe list' 'browse the flag catalog'
    printf '  %-34s %s\n' 'vroot ls' 'list your sandboxes'
    printf '  %-34s %s\n' 'vroot filetype install' 'register the .vroot image file type'
    printf '\n'
    printf '  %sTry one of the commands above, or run "vroot help" for everything.%s\n' "$CD" "$C0"
}

cmd_help() {
    cat <<EOF
vroot $VERSION - a root shell in a sandbox, built from a flag.

USAGE
  vroot [FLAGS] [NAME] [OPTIONS] [-- COMMAND]

  A bare 'vroot' prints this banner. Add flags to include languages/tools.
  A bare NAME makes the sandbox persistent (reuse it by name).

FLAGS (one per tool; combine freely)
  python node deno bun php ruby perl lua r julia
  go rust zig nim crystal d swift
  gcc clang cmake gfortran nasm
  java kotlin scala clojure groovy dotnet fsharp
  haskell elixir erlang ocaml
  sqlite postgres mysql git openssh curl vim
  base
  (run 'vroot recipe list' for the full catalog and 'vroot recipe new NAME' to add your own)

EXAMPLES
  vroot                          root shell (Alpine base)
  vroot -python                  root shell with Python
  vroot -node -python            root shell with Node + Python
  vroot -sqlite -python db       persistent sandbox named 'db'
  vroot -rust -- cargo build     run a command instead of a shell
  vroot -go -v ~/src:/src -- ls /src
  vroot -node -offline           no network
  vroot -python -cwd /tmp        different working directory

OPTIONS
  -v SRC[:DST][:ro]   expose a host path (default: nothing from the host)
  -offline            no network (loopback only)
  -cwd DIR            working directory (default /root)
  -env K=V            set an environment variable
  -name NAME          persistent sandbox name
  -hostname H         hostname inside (default: the sandbox name)
  -clean              empty environment
  -rm                 delete the sandbox after this session

MANAGEMENT
  vroot ls                     list sandboxes
  vroot rm NAME...|--all       delete sandboxes
  vroot save NAME [OUT.vroot]  pack a sandbox into one image file
  vroot IMAGE.vroot            boot from a saved image file
  vroot filetype [install]     register the .vroot image file type with the OS
  vroot recipe list|show|new|edit|path
  vroot envs                   list built env images
  vroot prune                  clear caches/tmp
  vroot info NAME              sandbox details
  vroot doctor                 check the host setup
  vroot doctor --probe         re-detect and cache sandbox capabilities
  vroot doctor --test-android  run the Android/Termux self-test

HOW IT WORKS
  - flags pick recipes -> a single-file env image (envs/*.sqfs) is built once
  - each session runs it via bubblewrap with full root capabilities, its own
    namespaces and its own filesystem; your host is not visible by default
  - on Linux the writable layer is a native overlayfs; on Android it falls back
    to fuse-overlayfs or a privileged root bridge when user namespaces are off
  - see docs/BUILDING.md to add your own language/tool, docs/ANDROID.md for Termux
EOF
}

main() {
    ensure_dirs
    local cmd="${1:-}"
    case "$cmd" in
        "")          cmd_banner ;;
        build)       shift; cmd_build "$@" ;;
        ls|list)     cmd_ls ;;
        rm|delete)   shift; cmd_rm "$@" ;;
        save)        shift; cmd_save "$@" ;;
        load)        shift; cmd_run "$@" ;;
        filetype)    shift; cmd_filetype "$@" ;;
        recipe|recipes) shift; cmd_recipe "$@" ;;
        envs|images) cmd_envs ;;
        prune|gc)    cmd_prune ;;
        info)        shift; cmd_info "$@" ;;
        doctor)      shift; cmd_doctor "${1:-}" ;;
        help|-h|--help) cmd_help ;;
        version|-V|--version) printf 'vroot %s\n' "$VERSION" ;;
        *)           cmd_run "$@" ;;
    esac
}

main "$@"
