    printf '%s' "$CB"
    cat <<'ART'

 __   __  ____   ___   ___  _____
 \ \ / / |  _ \ / _ \ / _ \ |_   _|
  \ V /  | |_) | | | | | | | |   | |
   | |   |  _ < | |_| | |_| |  | |
    |_|   |_| \_\ \___/ \___/    |_|
ART
    printf '%s' "$C0"
    printf '  %svroot %s%s — a root shell in a sandbox, built from a flag.\n\n' "$CD" "$VERSION" "$C0"
