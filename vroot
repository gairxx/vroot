#!/usr/bin/env bash
set -euo pipefail
umask 077

VERSION="2.2.1"

# Resolve our own path with pure bash so the hot path forks only when vroot is
# installed as a symlink (the common `~/.local/bin/vroot` case).
SELF="${BASH_SOURCE[0]:-$0}"
[[ "$SELF" == /* ]] || SELF="$PWD/${SELF#./}"
_links=0
while [[ -L "$SELF" ]]; do
    _target="$(readlink -- "$SELF" 2>/dev/null)" || break
    case "$_target" in
        /*) SELF="$_target" ;;
        *)  SELF="${SELF%/*}/$_target" ;;
    esac
    (( _links++ < 40 )) || break
done
unset _target _links
ROOTDIR="${SELF%/*}"; [[ -n "$ROOTDIR" ]] || ROOTDIR=/

VROOT_HOME="${VROOT_HOME:-$HOME/.local/share/vroot}"
VROOT_CONFIG="${VROOT_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/vroot}"
ENVS_DIR="$VROOT_HOME/envs"
CACHE_DIR="$VROOT_HOME/cache"
BASES_DIR="$CACHE_DIR/.bases"
INST_DIR="$VROOT_HOME/instances"
TMP_DIR="$VROOT_HOME/tmp"
BUILTIN_RECIPES="$ROOTDIR/recipes"
USER_RECIPES="$VROOT_CONFIG/recipes"
RECIPE_INDEX_DIR="$VROOT_HOME/recipe-index"

ALPINE_VER="3.20.3"
ALPINE_REL="v${ALPINE_VER%.*}"
ALPINE_CDN="https://dl-cdn.alpinelinux.org/alpine"
# Pinned rootfs checksums for the common arches; others verify against the
# CDN-published .sha256 file.
ALPINE_SHA256_X86_64="d4e6fd67dcf75e40c451560ac7265166c2b72a0f38ddc9aae756a7de3d1efa0c"
ALPINE_SHA256_AARCH64="041fa34a81788242df9e78fa69b97ab45b8ec47ddbf88864755610414a7bf3de"
DEBIAN_IMG="debian:bookworm-slim"

IMG_EXT="vroot"
MIME_TYPE="application/x-vroot-image"

BWRAP_BIN="${VROOT_BWRAP:-bwrap}"

RESERVED=" build ls list rm delete save load filetype recipe recipes envs images prune info help version doctor "

C0=$'\033[0m'; CB=$'\033[1;34m'; CG=$'\033[1;32m'; CY=$'\033[1;33m'; CR=$'\033[1;31m'; CD=$'\033[2m'
log()  { printf '%s==>%s %s\n' "$CB" "$C0" "$*" >&2; }
ok()   { printf '%s  ok%s %s\n' "$CG" "$C0" "$*" >&2; }
warn() { printf '%swarn%s %s\n' "$CY" "$C0" "$*" >&2; }
die()  { printf '%serr %s %s\n' "$CR" "$C0" "$*" >&2; exit 1; }
need_cmd() { command -v "$1" >/dev/null 2>&1; }

# --- host arch / alpine rootfs helpers ---------------------------------------
alpine_arch() {
    [[ -n "${VROOT_ALPINE_ARCH:-}" ]] && { printf '%s' "$VROOT_ALPINE_ARCH"; return 0; }
    case "$(uname -m 2>/dev/null || echo unknown)" in
        x86_64|amd64)        printf 'x86_64' ;;
        aarch64|arm64)       printf 'aarch64' ;;
        armv7l|armv7)        printf 'armv7' ;;
        armv6l|armv6)        printf 'armv6' ;;
        i386|i486|i586|i686) printf 'x86' ;;
        ppc64le)             printf 'ppc64le' ;;
        s390x)               printf 's390x' ;;
        riscv64)             printf 'riscv64' ;;
        *)                   printf 'x86_64' ;;
    esac
}
alpine_url() { printf '%s/%s/releases/%s/alpine-minirootfs-%s-%s.tar.gz' "$ALPINE_CDN" "$ALPINE_REL" "$1" "$ALPINE_VER" "$1"; }

fetch() { # URL DEST
    if need_cmd curl; then curl -fLsS -o "$2" "$1"
    elif need_cmd wget; then wget -qO "$2" "$1"
    else die "need curl or wget to download"; fi
}
fetch_sha256() { # ARTIFACT_URL -> prints expected sha256, or nothing
    local out; out="$(mktemp "$TMP_DIR/.sum.XXXXXX" 2>/dev/null)" || return 0
    if fetch "$1.sha256" "$out" 2>/dev/null; then cut -d' ' -f1 "$out" | head -1; fi
    rm -f "$out"
}

# --- sandbox root-layer engine -----------------------------------------------
# Each takes the bubblewrap option list (ending in `-- cmd...`) and starts the
# sandbox with the merged root bind-mounted at /.

spawn_native() {
    export VROOT_LOWER VROOT_UPPER VROOT_WORK VROOT_MERGED VROOT_RAM
    local -a b=( "$BWRAP_BIN" --unshare-user --uid 0 --gid 0 --cap-add ALL "$@" )
    unshare --user --map-root-user --mount -- /bin/sh -c '
        if [ -n "$VROOT_RAM" ]; then mount -t tmpfs none "$VROOT_RAM" || exit 70; fi
        mkdir -p "$VROOT_UPPER" "$VROOT_WORK" "$VROOT_MERGED" || exit 70
        mount -t overlay overlay -o "lowerdir=$VROOT_LOWER,upperdir=$VROOT_UPPER,workdir=$VROOT_WORK" "$VROOT_MERGED" || exit 70
        exec "$@"
    ' sh "${b[@]}"
}

ensure_dirs() {
    [[ -d "$ENVS_DIR" && -d "$CACHE_DIR" && -d "$BASES_DIR" && -d "$INST_DIR" && -d "$TMP_DIR" ]] && return 0
    mkdir -p "$ENVS_DIR" "$CACHE_DIR" "$BASES_DIR" "$INST_DIR" "$TMP_DIR"
}

valid_name() {
    [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
    [[ "$RESERVED" == *" $1 "* ]] && return 1
    return 0
}

rget() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -1; }
rall() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1"; }

# parse_recipe FILE -- read one recipe into R_* globals with no forked helpers.
parse_recipe() {
    local f="$1" line key val
    R_NAME="${f##*/}"; R_NAME="${R_NAME%.conf}"
    R_PROVIDES=""; R_BASE=""; R_PACKAGES=(); R_SETUP=(); R_ENV=""; R_PATH=""; R_VERIFY=(); R_DESC=""; R_DOCS=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        case "$line" in ''|'#'*) continue ;; esac
        line="${line#"${line%%[![:space:]]*}"}"
        key="${line%%=*}"; [[ "$key" == "$line" ]] && continue
        key="${key%"${key##*[![:space:]]}"}"
        val="${line#*=}"; val="${val#"${val%%[![:space:]]*}"}"
        case "$key" in
            name)        R_NAME="$val" ;;
            provides)    R_PROVIDES="$val" ;;
            base)        R_BASE="$val" ;;
            packages)    R_PACKAGES+=("$val") ;;
            setup)       R_SETUP+=("$val") ;;
            env)         R_ENV="$val" ;;
            path)        R_PATH="$val" ;;
            verify)      R_VERIFY+=("$val") ;;
            description) R_DESC="$val" ;;
            docs)        R_DOCS="$val" ;;
        esac
    done < "$f"
    R_BASE="${R_BASE:-alpine}"
    R_PROVIDES="${R_PROVIDES:-$R_NAME}"
}

RESOLVED_FILE=""
RESOLVED_NAME=""
RESOLVED_BASE=""
declare -A RECIPE_META_NAME
declare -A RECIPE_META_BASE

# Flag -> recipe index: one tiny file per flag under $RECIPE_INDEX_DIR, so a
# lookup is a single read instead of parsing every recipe. Parsing costs ~0.7ms
# per file; the naive resolver re-parsed every user recipe for every flag.
RECIPE_INDEX_READY=0
RECIPE_INDEX_OK=0

safe_recipe_flag() {
    [[ "$1" =~ ^[A-Za-z0-9_.+#-]+$ && "$1" != . && "$1" != .. ]]
}

recipe_index_stale() {
    [[ -f "$RECIPE_INDEX_DIR/.stamp" ]] || return 0
    local f
    for f in "$BUILTIN_RECIPES"/*.conf "$USER_RECIPES"/*.conf; do
        [[ -f "$f" && "$f" -nt "$RECIPE_INDEX_DIR/.stamp" ]] && return 0
    done
    return 1
}

build_recipe_index() {
    local dir f p b tmp="$RECIPE_INDEX_DIR.new.$$"
    [[ -d "$VROOT_HOME" ]] || mkdir -p "$VROOT_HOME" 2>/dev/null || return 1
    rm -rf "$tmp"; mkdir -p "$tmp" || return 1
    # Built-ins first, then user recipes: later writes win. Within a tier
    # "provides" is written before plain names so direct names take precedence,
    # matching the live resolver's lookup order.
    for dir in "$BUILTIN_RECIPES" "$USER_RECIPES"; do
        [[ -d "$dir" ]] || continue
        for f in "$dir"/*.conf; do
            [[ -f "$f" ]] || continue
            parse_recipe "$f"
            for p in ${R_PROVIDES//,/ }; do
                safe_recipe_flag "$p" || continue
                printf '%s\t%s\t%s\n' "$f" "$R_NAME" "$R_BASE" > "$tmp/$p"
            done
        done
        for f in "$dir"/*.conf; do
            [[ -f "$f" ]] || continue
            b="${f##*/}"; b="${b%.conf}"
            safe_recipe_flag "$b" || continue
            parse_recipe "$f"
            printf '%s\t%s\t%s\n' "$f" "$R_NAME" "$R_BASE" > "$tmp/$b"
        done
    done
    : > "$tmp/.stamp"
    rm -rf "$RECIPE_INDEX_DIR"
    mv "$tmp" "$RECIPE_INDEX_DIR" 2>/dev/null || { rm -rf "$tmp"; return 1; }
    return 0
}

# index_lookup FLAG -- set IDX_PATH/IDX_NAME/IDX_BASE; 1 if no entry.
IDX_PATH=""; IDX_NAME=""; IDX_BASE=""
index_lookup() {
    IDX_PATH=""; IDX_NAME=""; IDX_BASE=""
    safe_recipe_flag "$1" || return 1
    local entry="$RECIPE_INDEX_DIR/$1"
    [[ -f "$entry" ]] || return 1
    IFS=$'\t' read -r IDX_PATH IDX_NAME IDX_BASE < "$entry" || { IDX_PATH=""; return 1; }
    [[ -n "$IDX_PATH" ]]
}

# recipe_file_for FLAG -- resolve a flag/alias to a recipe file (lazy, memoized).
# Sets RESOLVED_FILE and returns 0, or returns 1 if unknown.
recipe_file_for() {
    local flag="$1" g f=""
    if [[ -n "${RECIPE_FILE[$flag]:-}" ]]; then
        f="${RECIPE_FILE[$flag]}"
        if [[ -z "${RECIPE_META_NAME[$f]:-}" ]]; then
            parse_recipe "$f"; RECIPE_META_NAME["$f"]="$R_NAME"; RECIPE_META_BASE["$f"]="$R_BASE"
        fi
        RESOLVED_FILE="$f"; RESOLVED_NAME="${RECIPE_META_NAME[$f]}"; RESOLVED_BASE="${RECIPE_META_BASE[$f]}"
        return 0
    fi
    if [[ "$RECIPE_INDEX_READY" != 1 ]]; then
        RECIPE_INDEX_READY=1
        if recipe_index_stale; then
            build_recipe_index >/dev/null 2>&1 && RECIPE_INDEX_OK=1 || RECIPE_INDEX_OK=0
        else
            RECIPE_INDEX_OK=1
        fi
    fi
    if [[ "$RECIPE_INDEX_OK" == 1 ]] && safe_recipe_flag "$flag"; then
        if index_lookup "$flag"; then
            f="$IDX_PATH"
            if [[ -f "$f" && ( "$f" == "$USER_RECIPES/"* || "$f" == "$BUILTIN_RECIPES/"* ) ]]; then
                RECIPE_META_NAME["$f"]="$IDX_NAME"; RECIPE_META_BASE["$f"]="$IDX_BASE"
                RECIPE_FILE["$flag"]="$f"; RESOLVED_FILE="$f"; RESOLVED_NAME="$IDX_NAME"; RESOLVED_BASE="$IDX_BASE"
                return 0
            fi
            # Entry points at a removed recipe: rebuild and retry once.
            if build_recipe_index >/dev/null 2>&1 && index_lookup "$flag"; then
                f="$IDX_PATH"
                if [[ -f "$f" && ( "$f" == "$USER_RECIPES/"* || "$f" == "$BUILTIN_RECIPES/"* ) ]]; then
                    RECIPE_META_NAME["$f"]="$IDX_NAME"; RECIPE_META_BASE["$f"]="$IDX_BASE"
                    RECIPE_FILE["$flag"]="$f"; RESOLVED_FILE="$f"; RESOLVED_NAME="$IDX_NAME"; RESOLVED_BASE="$IDX_BASE"
                    return 0
                fi
            fi
            RECIPE_INDEX_OK=0
        fi
    fi
    [[ -f "$USER_RECIPES/$flag.conf" ]] && f="$USER_RECIPES/$flag.conf"
    if [[ -z "$f" ]]; then
        for g in "$USER_RECIPES"/*.conf; do
            [[ -f "$g" ]] || continue
            parse_recipe "$g"
            [[ ",${R_PROVIDES// /}," == *",$flag,"* ]] && f="$g"
        done
    fi
    [[ -z "$f" && -f "$BUILTIN_RECIPES/$flag.conf" ]] && f="$BUILTIN_RECIPES/$flag.conf"
    if [[ -z "$f" ]]; then
        for g in "$BUILTIN_RECIPES"/*.conf; do
            [[ -f "$g" ]] || continue
            parse_recipe "$g"
            [[ ",${R_PROVIDES// /}," == *",$flag,"* ]] && f="$g"
        done
    fi
    [[ -n "$f" ]] || return 1
    parse_recipe "$f"
    RECIPE_META_NAME["$f"]="$R_NAME"; RECIPE_META_BASE["$f"]="$R_BASE"
    RECIPE_FILE["$flag"]="$f"; RESOLVED_FILE="$f"; RESOLVED_NAME="$R_NAME"; RESOLVED_BASE="$R_BASE"
    return 0
}

meta_get() { [[ -f "$1" ]] && sed -n "s/^$2=//p" "$1" | head -1 || true; }
fsize() { du -sh "$1" 2>/dev/null | cut -f1 || true; }
meta_set() { local f="$1"; shift; : > "$f"; local kv; for kv in "$@"; do printf '%s\n' "$kv" >> "$f"; done; }

fsize_bytes() { local n; n="$(du -sb "$1" 2>/dev/null | cut -f1 || true)"; printf '%s' "${n:-0}"; }
json_str() { local s="$1"; s="${s//\\/\\\\}"; s="${s//\"/\\\"}"; printf '"%s"' "$s"; }
json_bool() { if [[ "$1" == 1 ]]; then printf true; else printf false; fi; }
# emit_env PATH CACHED -- build_env output contract (JSON callers ask for both).
emit_env() { if [[ -n "${VROOT_BUILD_REPORT:-}" ]]; then printf '%s\t%s\n' "$1" "$2"; else printf '%s\n' "$1"; fi; }

declare -A RECIPE_FILE
declare -A RECIPE_DESC

load_recipes() {
    RECIPE_FILE=(); RECIPE_DESC=()
    local dir f p
    for dir in "$BUILTIN_RECIPES" "$USER_RECIPES"; do
        [[ -d "$dir" ]] || continue
        for f in "$dir"/*.conf; do
            [[ -f "$f" ]] || continue
            parse_recipe "$f"
            RECIPE_FILE["$R_NAME"]="$f"
            for p in ${R_PROVIDES//,/ }; do RECIPE_FILE["$p"]="$f"; done
            RECIPE_DESC["$R_NAME"]="$R_DESC"
        done
    done
}

ensure_base() {
    local base="$1" dest="$BASES_DIR/$base" marker="$BASES_DIR/.${base}.ready"
    [[ -f "$marker" && -d "$dest" ]] && return 0
    rm -rf "$dest"; mkdir -p "$dest"
    case "$base" in
        alpine)
            local arch url want
            arch="$(alpine_arch)"; url="$(alpine_url "$arch")"
            log "fetching Alpine $ALPINE_VER ($arch) base rootfs ..."
            local tb; tb="$(mktemp "$TMP_DIR/.alpine.XXXXXX.tar.gz")"
            fetch "$url" "$tb" || { rm -f "$tb"; die "download failed"; }
            case "$arch" in
                x86_64)  want="$ALPINE_SHA256_X86_64" ;;
                aarch64) want="$ALPINE_SHA256_AARCH64" ;;
                *)       want="$(fetch_sha256 "$url")" ;;
            esac
            if [[ -n "$want" ]]; then
                local got; got="$(sha256sum "$tb" | cut -d' ' -f1)"
                [[ "$got" == "$want" ]] || { rm -f "$tb"; die "base rootfs checksum mismatch (expected $want, got $got)"; }
            else
                warn "no published checksum for alpine/$arch; skipping verification"
            fi
            tar -xzf "$tb" -C "$dest" || { rm -f "$tb"; die "extract failed"; }
            rm -f "$tb"
            ;;
        debian)
            need_cmd docker || die "the Debian base needs docker; use an Alpine-based recipe"
            log "fetching Debian base ('$DEBIAN_IMG') via docker ..."
            local cid
            cid="$(docker create "$DEBIAN_IMG")" || die "docker create failed"
            docker export "$cid" | tar -x -C "$dest" || { docker rm -f "$cid" >/dev/null 2>&1; die "export failed"; }
            docker rm "$cid" >/dev/null 2>&1 || true
            ;;
        *) die "unknown base '$base' (use alpine or debian)" ;;
    esac
    : > "$marker"
}

run_in_root() {
    local dir="$1" script="$2"
    local -a b=( --unshare-user --uid 0 --gid 0 --cap-add ALL
        --unshare-pid --unshare-uts --unshare-ipc --unshare-cgroup-try
        --die-with-parent
        --bind "$dir" / --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run
        --ro-bind-try /sys /sys --hostname builder
        --setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
        -- /bin/sh -c "$script")
    "$BWRAP_BIN" "${b[@]}"
}

# build_env_docker BASE SLUG ENVFILE PACKAGES SETUP VERIFY PATHS ENVS
build_env_docker() {
    local base="$1" slug="$2" envfile="$3" packages="$4" setup="$5" verify="$6" paths="$7" envs="$8"
    need_cmd docker || die "docker is required to build '$slug' (base=$base)"
    local img="$DEBIAN_IMG"
    log "building env '$slug' (base=$base, via docker) ..."
    local script=""
    script+="set -e"$'\n'
    if [[ -n "$paths" ]]; then
        script+="export PATH=$paths:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"$'\n'
    else
        script+="export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"$'\n'
    fi
    if [[ -n "$packages" ]]; then
        script+="export DEBIAN_FRONTEND=noninteractive"$'\n'"apt-get update"$'\n'"apt-get install -y --no-install-recommends $packages"$'\n'
    fi
    [[ -n "$setup" ]] && script+="$setup"
    [[ -n "$verify" ]] && script+="$verify"
    local cname="vroot-build-$$-$RANDOM"
    if ! docker run --name "$cname" "$img" /bin/sh -c "$script" 1>&2; then
        docker rm -f "$cname" >/dev/null 2>&1 || true
        die "build failed for env '$slug'"
    fi
    local tmp; tmp="$(mktemp -d "$TMP_DIR/build.XXXXXX")"
    if ! docker export "$cname" | tar -x -C "$tmp"; then
        docker rm -f "$cname" >/dev/null 2>&1 || true
        rm -rf "$tmp"; die "export failed for env '$slug'"
    fi
    docker rm -f "$cname" >/dev/null 2>&1 || true
    mkdir -p "$tmp/proc" "$tmp/sys" "$tmp/dev" "$tmp/tmp" "$tmp/run" "$tmp/root" "$tmp/etc/vroot"
    chmod 1777 "$tmp/tmp" 2>/dev/null || true
    rm -f "$tmp/etc/resolv.conf" 2>/dev/null || true
    [[ -r /etc/resolv.conf ]] && cp /etc/resolv.conf "$tmp/etc/resolv.conf" 2>/dev/null || true
    {
        if [[ -n "$paths" ]]; then
            printf 'export PATH=%s:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' "$paths"
        else
            printf 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n'
        fi
        [[ -n "$envs" ]] && printf '%s\n' "$envs"
    } > "$tmp/etc/vroot/env"
    printf '\n[ -r /etc/vroot/env ] && . /etc/vroot/env\n' >> "$tmp/etc/profile"
    mksquashfs "$tmp" "$envfile" -all-root -comp zstd -noappend -no-progress -quiet >/dev/null 2>&1 || { rm -rf "$tmp"; die "mksquashfs failed"; }
    rm -rf "$tmp"
    ok "built env '$slug' -> $envfile ($(fsize "$envfile"))"
    emit_env "$envfile" 0
}

build_env() {
    ensure_dirs
    local flags=("$@"); [[ ${#flags[@]} -eq 0 ]] && flags=(base)

    local -a rfiles=() names=()
    local -A _rseen=()
    local base="alpine"
    local f flag
    for flag in "${flags[@]}"; do
        recipe_file_for "$flag" || die "unknown flag -$flag (no recipe). Try: vroot recipe list"
        f="$RESOLVED_FILE"
        [[ -n "${_rseen[$f]:-}" ]] && continue
        _rseen[$f]=1
        rfiles+=("$f")
        names+=("$RESOLVED_NAME")
        [[ "$RESOLVED_BASE" == debian ]] && base="debian"
    done
    [[ ${#rfiles[@]} -gt 0 ]] || die "no recipes resolved"

    local slug; local IFS='+'; slug="${names[*]}"; unset IFS

    local envfile hash
    local blob="" t
    for f in "${rfiles[@]}"; do
        t=""; IFS= read -r -d '' t < "$f" || true
        blob+="$t"
    done
    hash="$( { printf '%s' "$blob"; printf 'base=%s\n' "$base"; } | sha256sum )"
    hash="${hash:0:10}"

    envfile="$ENVS_DIR/${slug}-${hash}.sqfs"
    if [[ -f "$envfile" ]]; then
        emit_env "$envfile" 1; return 0
    fi

    # One image, one builder: parallel agents asking for the same flag set wait
    # for the first build instead of racing mksquashfs on the same path.
    local tlock="$envfile.lock" waited=0
    if ! mkdir "$tlock" 2>/dev/null; then
        while [[ ! -f "$envfile" && $waited -lt 900 ]]; do sleep 0.2; waited=$((waited+1)); done
        if [[ -f "$envfile" ]]; then emit_env "$envfile" 1; return 0; fi
        rm -rf "$tlock"; mkdir "$tlock" 2>/dev/null || true
    fi
    VROOT_BUILD_LOCK="$tlock"
    trap 'rm -rf "${VROOT_BUILD_LOCK:-}"' EXIT

    local packages="" setup="" envs="" paths="" verify="" p
    local -a pkgs=(); local -A pseen=()
    for f in "${rfiles[@]}"; do
        parse_recipe "$f"
        if ((${#R_PACKAGES[@]})); then for p in "${R_PACKAGES[@]}"; do [[ -n "$p" ]] && packages+=" $p"; done; fi
        if ((${#R_SETUP[@]}));    then for p in "${R_SETUP[@]}";    do [[ -n "$p" ]] && setup+="$p"$'\n'; done; fi
        [[ -n "$R_ENV" ]]  && envs+="${R_ENV//,/ }"$'\n'
        [[ -n "$R_PATH" ]] && paths+="${R_PATH}:"$'\n'
        if ((${#R_VERIFY[@]}));   then for p in "${R_VERIFY[@]}";   do [[ -n "$p" ]] && verify+="$p"$'\n'; done; fi
    done
    for p in $packages; do [[ -n "${pseen[$p]:-}" ]] && continue; pseen[$p]=1; pkgs+=("$p"); done
    packages="${pkgs[*]}"
    paths="${paths%$'\n'}"; paths="${paths//$'\n'/}"; paths="${paths%:}"

    if [[ "$base" == debian ]] && { [[ -n "$packages" ]] || [[ -n "$setup" ]]; }; then
        build_env_docker "$base" "$slug" "$envfile" "$packages" "$setup" "$verify" "$paths" "$envs"
        return 0
    fi

    ensure_base "$base"
    log "building env '$slug' (base=$base) ..."
    local tmp; tmp="$(mktemp -d "$TMP_DIR/build.XXXXXX")"
    cp -a "$BASES_DIR/$base/." "$tmp/"
    mkdir -p "$tmp/proc" "$tmp/sys" "$tmp/dev" "$tmp/tmp" "$tmp/run" "$tmp/root" "$tmp/etc/vroot"
    chmod 1777 "$tmp/tmp" 2>/dev/null || true
    [[ -r /etc/resolv.conf ]] && cp /etc/resolv.conf "$tmp/etc/resolv.conf" 2>/dev/null || true

    case "$base" in
        alpine)
            printf '%s\n' \
                "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VER%.*}/main" \
                "https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VER%.*}/community" \
                > "$tmp/etc/apk/repositories"
            ;;
        debian)
            printf 'deb http://deb.debian.org/debian bookworm main\ndeb http://deb.debian.org/debian bookworm-updates main\n' \
                > "$tmp/etc/apt/sources.list"
            ;;
    esac

    {
        if [[ -n "$paths" ]]; then
            printf 'export PATH=%s:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n' "$paths"
        else
            printf 'export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin\n'
        fi
        [[ -n "$envs" ]] && printf '%s\n' "$envs"
    } > "$tmp/etc/vroot/env"

    printf '\n[ -r /etc/vroot/env ] && . /etc/vroot/env\n' >> "$tmp/etc/profile"

    local script=""
    script+="set -e"$'\n'
    if [[ -n "$packages" ]]; then
        case "$base" in
            alpine) script+="apk update"$'\n'"apk add --no-cache $packages"$'\n' ;;
            debian) script+="export DEBIAN_FRONTEND=noninteractive"$'\n'"apt-get update"$'\n'"apt-get install -y --no-install-recommends $packages"$'\n' ;;
        esac
    fi
    [[ -n "$setup" ]]  && script+="$setup"
    [[ -n "$verify" ]] && script+="$verify"

    if ! run_in_root "$tmp" "$script" 1>&2; then
        rm -rf "$tmp"
        die "build failed for env '$slug'"
    fi

    mksquashfs "$tmp" "$envfile" -all-root -comp zstd -noappend -no-progress -quiet >/dev/null 2>&1 \
        || { rm -rf "$tmp"; die "mksquashfs failed"; }
    rm -rf "$tmp"
    ok "built env '$slug' -> $envfile ($(fsize "$envfile"))"
    emit_env "$envfile" 0
}

ensure_cache() {
    local envfile="$1"
    local cache="$2"
    local marker="$CACHE_DIR/.${cache##*/}.ready"
    if [[ -f "$marker" && -d "$cache" ]]; then return 0; fi
    mkdir -p "$CACHE_DIR"
    # Unpack into a private dir and swap it in, so parallel agents launching the
    # same env never observe (or delete) each other's half-written tree.
    local tmp="$cache.tmp.$$"
    rm -rf "$tmp"
    unsquashfs -q -d "$tmp" "$envfile" >/dev/null 2>&1 || { rm -rf "$tmp"; die "cannot unpack env image: $envfile"; }
    rm -rf "$cache"
    if ! mv "$tmp" "$cache" 2>/dev/null; then
        rm -rf "$tmp"
        [[ -d "$cache" ]] || die "cannot install env cache: $cache"
    fi
    : > "$marker"
}

O_FLAGS=(); O_ENV=(); O_VOLUMES=(); O_CMD=()
O_OFFLINE=0; O_CLEAN=0; O_KEEP=0; O_RM=0
O_NAME=""; O_HOSTNAME=""; O_CWD=""; O_ENVFILE=""; O_JSON=0

parse_args() {
    O_FLAGS=(); O_ENV=(); O_VOLUMES=(); O_CMD=()
    O_OFFLINE=0; O_CLEAN=0; O_KEEP=0; O_RM=0
    O_NAME=""; O_HOSTNAME=""; O_CWD=""; O_ENVFILE=""; O_JSON=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --) shift; O_CMD=("$@"); break ;;
            -offline|--offline|-o) O_OFFLINE=1; shift ;;
            -net|--net) O_OFFLINE=0; shift ;;
            -clean|--clean) O_CLEAN=1; shift ;;
            -keep|--keep|-k) O_KEEP=1; shift ;;
            -rm|--rm) O_RM=1; shift ;;
            -v|--volume) O_VOLUMES+=("${2:?use -v SRC[:DST][:ro]}"); shift 2 ;;
            -v=*|--volume=*) O_VOLUMES+=("${1#*=}"); shift ;;
            -env|--env) O_ENV+=("${2:?use -env K=V}"); shift 2 ;;
            -env=*|--env=*) O_ENV+=("${1#*=}"); shift ;;
            -cwd|--cwd) O_CWD="${2:?use -cwd DIR}"; shift 2 ;;
            -cwd=*|--cwd=*) O_CWD="${1#*=}"; shift ;;
            -name|--name) O_NAME="${2:?use -name NAME}"; shift 2 ;;
            -name=*|--name=*) O_NAME="${1#*=}"; shift ;;
            -hostname|--hostname) O_HOSTNAME="${2:?}"; shift 2 ;;
            -hostname=*|--hostname=*) O_HOSTNAME="${1#*=}"; shift ;;
            -json|--json) O_JSON=1; shift ;;
            -h|--help) O_NAME="__help__"; shift ;;
            -*) local fl="${1#-}"; fl="${fl#-}"
                if recipe_file_for "$fl"; then O_FLAGS+=("$fl"); else die "unknown flag -$fl (try: vroot recipe list)"; fi
                shift ;;
            *.sqfs|*.vroot) [[ -f "$1" ]] || die "no such image file: $1"; O_ENVFILE="$1"; shift ;;
            */*)    [[ -f "$1" ]] || die "not a sandbox name or file: $1"; O_ENVFILE="$1"; shift ;;
            *) [[ -z "$O_NAME" ]] || die "unexpected argument: $1"; O_NAME="$1"; shift ;;
        esac
    done
}

launch() {
    local envfile="$1" name="${2:-}"
    local cname cache
    cname="${envfile##*/}"; cname="${cname%.vroot}"; cname="${cname%.sqfs}"
    cache="$CACHE_DIR/$cname"
    ensure_cache "$envfile" "$cache"

    local upper work merged ram idir
    ram=""
    if [[ -n "$name" ]]; then
        valid_name "$name" || die "invalid sandbox name: '$name'"
        idir="$INST_DIR/$name"
        if [[ ! -d "$idir" ]]; then
            mkdir -p "$idir"
            meta_set "$idir/meta" "ENV=$cname" "IMG=$envfile" "CREATED=$(date -Is)"
        fi
        upper="$idir/upper"; work="$idir/work"; merged="$idir/.merged"
        if [[ ! -d "$upper" || ! -d "$work" || ! -d "$merged" ]]; then
            mkdir -p "$upper" "$work" "$merged"
        fi
        local -a stale=("$work"/*)
        [[ -e "${stale[0]}" ]] && rm -rf "${stale[@]}"
    else
        # Ephemeral scratch lives in a tmpfs mounted inside the sandbox's own
        # mount namespace: nothing is created on, or cleaned from, the host.
        local runroot="$TMP_DIR/.run.$$.$RANDOM"
        upper="$runroot/upper"; work="$runroot/work"; merged="$runroot/merged"
        ram="$TMP_DIR"
    fi

    local host="${O_HOSTNAME:-${name:-vroot}}"
    local cwd="${O_CWD:-/root}"

    local -a bargs=( --unshare-pid --unshare-uts --unshare-ipc --unshare-cgroup-try
        --die-with-parent
        --bind "$merged" / --proc /proc --dev /dev --tmpfs /tmp --tmpfs /run
        --ro-bind-try /sys /sys --hostname "$host" --chdir "$cwd" )
    [[ "$O_OFFLINE" == 1 ]] && bargs+=(--unshare-net)
    [[ "$O_CLEAN" == 1 ]] && bargs+=(--clearenv)
    bargs+=(--setenv PATH /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/root/.local/bin)
    bargs+=(--setenv HOME /root)
    bargs+=(--setenv VROOT_ENV "$cname")
    bargs+=(--setenv TERM "${TERM:-xterm-256color}")

    local e
    for e in "${O_ENV[@]}"; do bargs+=(--setenv "${e%%=*}" "${e#*=}"); done

    local v src dst mode
    for v in "${O_VOLUMES[@]}"; do
        src="${v%%:*}"; dst="${v#*:}"; mode="rw"
        if [[ "$dst" == *:* ]]; then mode="${dst##*:}"; dst="${dst%:*}"; fi
        [[ "$dst" == "$v" || -z "$dst" ]] && dst="$src"
        case "$dst" in /*) ;; *) dst="/$dst" ;; esac
        case "$src" in /*) ;; *) src="$PWD/$src" ;; esac
        case "$mode" in
            ro) bargs+=(--ro-bind-try "$src" "$dst") ;;
            rw) bargs+=(--bind-try "$src" "$dst") ;;
            *)  die "bad -v mode '$mode' (use :ro)" ;;
        esac
    done

    local -a cmd=("${O_CMD[@]}")
    [[ ${#cmd[@]} -eq 0 ]] && cmd=(/bin/sh -l)
    bargs+=(-- "${cmd[@]}")

    export VROOT_LOWER="$cache" VROOT_UPPER="$upper" VROOT_WORK="$work" VROOT_MERGED="$merged" VROOT_RAM="$ram"
    spawn_native "${bargs[@]}"
    local rc=$?
    [[ "$O_RM" == 1 && -n "$name" ]] && rm_instance "$name"
    return $rc
}

rm_instance() {
    local name="$1"
    local idir="$INST_DIR/$name"
    [[ -d "$idir" ]] || { warn "no such sandbox: $name"; return 0; }
    chmod -R u+rwX "$idir" 2>/dev/null || true
    rm -rf "$idir"
    ok "removed sandbox '$name'"
}

cmd_run() {
    parse_args "$@"
    [[ "$O_NAME" == "__help__" ]] && { cmd_help; return 0; }

    local envfile name="$O_NAME"
    if [[ -n "$O_ENVFILE" ]]; then
        envfile="$(readlink -f "$O_ENVFILE")"
    elif [[ ${#O_FLAGS[@]} -gt 0 ]]; then
        envfile="$(build_env "${O_FLAGS[@]}")" || exit 1
    elif [[ -n "$name" && -f "$INST_DIR/$name/meta" ]]; then
        local im; im="$(meta_get "$INST_DIR/$name/meta" IMG)"
        if [[ -n "$im" && -f "$im" ]]; then envfile="$im"
        else envfile="$ENVS_DIR/$(meta_get "$INST_DIR/$name/meta" ENV).sqfs"; fi
    else
        envfile="$(build_env base)" || exit 1
    fi

    if [[ -n "$name" && -f "$INST_DIR/$name/meta" ]]; then
        local cur curimg; cur="$(meta_get "$INST_DIR/$name/meta" ENV)"; curimg="$(meta_get "$INST_DIR/$name/meta" IMG)"
        if [[ -n "$curimg" && -f "$curimg" ]]; then
            [[ "$(readlink -f "$envfile")" == "$(readlink -f "$curimg")" ]] \
                || die "sandbox '$name' already uses env '$cur'; use another name or 'vroot rm $name'"
        else
            local curname="${envfile##*/}"; curname="${curname%.vroot}"; curname="${curname%.sqfs}"
            [[ "$curname" == "$cur" ]] || die "sandbox '$name' already uses env '$cur'; use another name or 'vroot rm $name'"
        fi
    fi

    launch "$envfile" "$name"
}

cmd_build() {
    parse_args "$@"
    local out envfile cached=0
    if [[ ${#O_FLAGS[@]} -gt 0 ]]; then out="$(VROOT_BUILD_REPORT=1 build_env "${O_FLAGS[@]}")"; else out="$(VROOT_BUILD_REPORT=1 build_env base)"; fi
    if [[ "$out" == *$'\t'* ]]; then envfile="${out%%$'\t'*}"; cached="${out#*$'\t'}"; else envfile="$out"; fi
    if [[ "$O_JSON" == 1 ]]; then
        printf '{"env":%s,"cached":%s}\n' "$(json_str "$envfile")" "$(json_bool "$cached")"
    else
        ok "env file: $envfile"
    fi
}

cmd_ls() {
    ensure_dirs
    local json=0
    [[ "${1:-}" == --json || "${1:-}" == -json ]] && json=1
    if [[ "$json" == 1 ]]; then
        local sep="" n idir env sz cre age t
        printf '['
        for idir in "$INST_DIR"/*; do
            [[ -d "$idir" ]] || continue
            n="$(basename "$idir")"
            env="$(meta_get "$idir/meta" ENV)"; cre="$(meta_get "$idir/meta" CREATED)"
            sz="$(fsize_bytes "$idir")"; age=null
            if [[ -n "$cre" ]]; then t=$(date -d "$cre" +%s 2>/dev/null || echo 0); [[ $t -gt 0 ]] && age="$(( ($(date +%s)-t)/60 ))"; fi
            printf '%s{"name":%s,"env":%s,"image":%s,"bytes":%s,"age_minutes":%s}' "$sep" \
                "$(json_str "$n")" "$(json_str "$env")" "$(json_str "$(meta_get "$idir/meta" IMG)")" "${sz:-0}" "$age"
            sep=","
        done
        printf ']\n'
        return 0
    fi
    printf '%s%-22s %-26s %-6s %s%s\n' "$CB" SANDBOX ENV SIZE AGE "$C0"
    local found=0 n idir env sz cre age t
    for idir in "$INST_DIR"/*; do
        [[ -d "$idir" ]] || continue
        found=1; n="$(basename "$idir")"
        env="$(meta_get "$idir/meta" ENV)"; cre="$(meta_get "$idir/meta" CREATED)"
        sz="$(fsize "$idir")"
        age="-"
        if [[ -n "$cre" ]]; then t=$(date -d "$cre" +%s 2>/dev/null || echo 0); [[ $t -gt 0 ]] && age="$(( ($(date +%s)-t)/60 ))m"; fi
        printf '%-22s %-26s %-6s %s\n' "$n" "${env:--}" "${sz:--}" "$age"
    done
    [[ $found == 1 ]] || printf '  %s(no sandboxes yet - try: vroot -python)%s\n' "$CD" "$C0"
}

cmd_rm() {
    ensure_dirs
    local all=0 chats=0 names=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all|-a) all=1; shift ;;
            *) names+=("$1"); shift ;;
        esac
    done
    if [[ $all == 1 ]]; then
        local d; for d in "$INST_DIR"/*; do [[ -d "$d" ]] && names+=("$(basename "$d")"); done
    fi
    [[ ${#names[@]} -gt 0 ]] || die "usage: vroot rm NAME... | --all"
    local n; for n in "${names[@]}"; do rm_instance "$n"; done
}

cmd_envs() {
    ensure_dirs
    local json=0
    [[ "${1:-}" == --json || "${1:-}" == -json ]] && json=1
    if [[ "$json" == 1 ]]; then
        local sep="" f
        printf '{"images":['
        for f in "$ENVS_DIR"/*.sqfs; do
            [[ -f "$f" ]] || continue
            printf '%s{"file":%s,"bytes":%s}' "$sep" "$(json_str "${f##*/}")" "$(fsize_bytes "$f")"
            sep=","
        done
        printf '],"bases":['
        sep=""
        for f in "$BASES_DIR"/*; do
            [[ -d "$f" ]] || continue
            printf '%s{"name":%s,"bytes":%s}' "$sep" "$(json_str "${f##*/}")" "$(fsize_bytes "$f")"
            sep=","
        done
        printf ']}\n'
        return 0
    fi
    printf '%s%-40s %-8s %s%s\n' "$CB" "ENV IMAGE" SIZE "$C0"
    local found=0 f
    for f in "$ENVS_DIR"/*.sqfs; do
        [[ -f "$f" ]] || continue
        found=1
        printf '%-40s %-8s\n' "$(basename "$f")" "$(fsize "$f")"
    done
    [[ $found == 1 ]] || printf '  %s(no env images yet - try: vroot -python)%s\n' "$CD" "$C0"
    printf '\n%sbase rootfs cache:%s\n' "$CD" "$C0"
    for f in "$BASES_DIR"/*; do [[ -d "$f" ]] && printf '  %-10s %s\n' "$(basename "$f")" "$(fsize "$f")"; done
}

cmd_prune() {
    ensure_dirs
    local f cname
    for f in "$CACHE_DIR"/*; do
        [[ -d "$f" ]] || continue
        [[ "$(basename "$f")" == .bases ]] && continue
        cname="$(basename "$f")"
        if [[ ! -f "$ENVS_DIR/$cname.sqfs" ]]; then
            rm -rf "$f" "$CACHE_DIR/.$cname.ready"
            ok "pruned cache '$cname'"
        fi
    done
    for f in "$TMP_DIR"/*; do [[ -e "$f" ]] && rm -rf "$f"; done
}

cmd_info() {
    local name="${1:-}" json=0
    [[ "${2:-}" == --json || "${2:-}" == -json ]] && json=1
    [[ -n "$name" ]] || die "usage: vroot info NAME [--json]"
    local idir="$INST_DIR/$name"; [[ -d "$idir" ]] || die "no such sandbox: $name"
    if [[ "$json" == 1 ]]; then
        printf '{"name":%s,"env":%s,"image":%s,"created":%s,"bytes":%s,"changed_files":%s,"path":%s}\n' \
            "$(json_str "$name")" "$(json_str "$(meta_get "$idir/meta" ENV)")" \
            "$(json_str "$(meta_get "$idir/meta" IMG)")" "$(json_str "$(meta_get "$idir/meta" CREATED)")" \
            "$(fsize_bytes "$idir")" "$(find "$idir/upper" -mindepth 1 2>/dev/null | wc -l || true)" "$(json_str "$idir")"
        return 0
    fi
    printf '%ssandbox%s %s\n' "$CB" "$C0" "$name"
    printf '  env:     %s\n' "$(meta_get "$idir/meta" ENV)"
    printf '  created: %s\n' "$(meta_get "$idir/meta" CREATED)"
    printf '  size:    %s\n' "$(fsize "$idir")"
    printf '  path:    %s\n' "$idir"
    printf '  changed: %s files in upper layer\n' "$(find "$idir/upper" -mindepth 1 2>/dev/null | wc -l || true)"
}

cmd_save() {
    local name="${1:-}" out="${2:-}"
    [[ -n "$name" ]] || die "usage: vroot save NAME [OUT.$IMG_EXT]"
    local idir="$INST_DIR/$name"; [[ -d "$idir" ]] || die "no such sandbox: $name"
    out="${out:-$PWD/$name.$IMG_EXT}"
    local envfile; envfile="$(meta_get "$idir/meta" IMG)"
    [[ -n "$envfile" && -f "$envfile" ]] || envfile="$ENVS_DIR/$(meta_get "$idir/meta" ENV).sqfs"
    [[ -f "$envfile" ]] || die "env image missing"
    local envcname="${envfile##*/}"; envcname="${envcname%.sqfs}"
    local cache="$CACHE_DIR/$envcname"
    ensure_cache "$envfile" "$cache"
    local upper="$idir/upper" work="$idir/work" merged="$idir/.merged"
    mkdir -p "$work" "$merged"
    export VROOT_LOWER="$cache" VROOT_UPPER="$upper" VROOT_WORK="$work" VROOT_MERGED="$merged"
    log "packing sandbox '$name' -> $out ..."
    unshare --user --map-root-user --mount -- /bin/sh -c '
        mount -t overlay overlay -o "lowerdir=$VROOT_LOWER,upperdir=$VROOT_UPPER,workdir=$VROOT_WORK" "$VROOT_MERGED" || exit 70
        exec mksquashfs "$VROOT_MERGED" "$1" -all-root -comp zstd -noappend -no-progress -quiet
    ' sh "$out" >/dev/null 2>&1 || die "pack failed"
    ok "saved -> $out ($(fsize "$out"))"
}

cmd_recipe() {
    load_recipes
    local sub="${1:-list}"; shift 2>/dev/null || true
    case "$sub" in
        list)
            printf '%s%-12s %-32s %-7s %s%s\n' "$CB" FLAG PROVIDES BASE DESC "$C0"
            local f name prov base desc
            for f in "$BUILTIN_RECIPES"/*.conf "$USER_RECIPES"/*.conf; do
                [[ -f "$f" ]] || continue
                name="$(basename "$f" .conf)"; prov="$(rget "$f" provides)"; base="$(rget "$f" base)"
                desc="$(rget "$f" description)"
                printf '%-12s %-32s %-7s %s\n' "$name" "${prov:-$name}" "${base:-alpine}" "$desc"
            done ;;
        show) local n="${1:?usage: vroot recipe show NAME}"; cat "${RECIPE_FILE[$n]:?no recipe '$n'}" ;;
        path) printf 'built-in: %s\nuser:     %s\n' "$BUILTIN_RECIPES" "$USER_RECIPES" ;;
        edit) local n="${1:?usage: vroot recipe edit NAME}"; "${EDITOR:-nano}" "${RECIPE_FILE[$n]:?no recipe '$n'}" ;;
        new)
            local n="${1:?usage: vroot recipe new NAME}"
            mkdir -p "$USER_RECIPES"
            local dst="$USER_RECIPES/$n.conf"
            [[ -e "$dst" ]] && die "recipe already exists: $dst"
            cat > "$dst" <<TEMPLATE
name = $n
provides = $n
base = alpine
packages =
setup =
env =
path =
verify = command -v $n
description = My $n environment
docs =
TEMPLATE
            ok "created $dst"
            "${EDITOR:-nano}" "$dst" ;;
        *) die "usage: vroot recipe list|show NAME|new NAME|edit NAME|path" ;;
    esac
}

cmd_filetype() {
    local sub="${1:-status}"
    local data="${XDG_DATA_HOME:-$HOME/.local/share}"
    local mime_dir="$data/mime"
    local pkg="$mime_dir/packages/vroot.xml"
    local app_dir="$data/applications"
    local desk="$app_dir/vroot-image.desktop"
    case "$sub" in
        install)
            mkdir -p "$mime_dir/packages" "$app_dir"
            cat > "$pkg" <<'XML'
<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-vroot-image">
    <comment>vroot sandbox image</comment>
    <icon name="application-x-vroot-image"/>
    <magic priority="60">
      <match type="string" value="hsqs" offset="0"/>
    </magic>
    <glob pattern="*.vroot"/>
    <glob pattern="*.sqfs"/>
  </mime-type>
</mime-info>
XML
            cat > "$desk" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=vroot sandbox image
Comment=Boot a vroot single-file sandbox image
Exec=$SELF %f
Terminal=true
Icon=utilities-terminal
Categories=Development;System;
MimeType=$MIME_TYPE;
EOF
            if need_cmd update-mime-database; then update-mime-database "$mime_dir" >/dev/null 2>&1 || true
            else warn "update-mime-database not found; MIME database not refreshed"; fi
            need_cmd update-desktop-database && update-desktop-database "$app_dir" >/dev/null 2>&1 || true
            ok "file type installed: $MIME_TYPE (*.$IMG_EXT, *.sqfs)"
            ok "mime package: $pkg"
            ok "handler:      $desk"
            ;;
        uninstall)
            rm -f "$pkg" "$desk"
            need_cmd update-mime-database && update-mime-database "$mime_dir" >/dev/null 2>&1 || true
            need_cmd update-desktop-database && update-desktop-database "$app_dir" >/dev/null 2>&1 || true
            ok "file type removed: $MIME_TYPE"
            ;;
        status)
            printf '%svroot file type%s\n' "$CB" "$C0"
            printf '  type:     %s\n' "$MIME_TYPE"
            printf '  globs:    *.%s  *.sqfs\n' "$IMG_EXT"
            printf '  mime:     %s [%s]\n' "$pkg" "$([[ -f "$pkg" ]] && printf present || printf missing)"
            printf '  handler:  %s [%s]\n' "$desk" "$([[ -f "$desk" ]] && printf present || printf missing)"
            if need_cmd xdg-mime; then
                local probe="$TMP_DIR/probe.$IMG_EXT"
                printf 'hsqs' > "$probe" 2>/dev/null || true
                printf '  detected: %s\n' "$(xdg-mime query filetype "$probe" 2>/dev/null || printf '-')"
                rm -f "$probe"
            fi
            ;;
        *) die "usage: vroot filetype [install|uninstall|status]" ;;
    esac
}

pkg_hint() { printf 'apt install %s' "$1"; }

cmd_doctor() {
    printf '%svroot %s%s\n\n' "$CB" "$VERSION" "$C0"
    printf 'platform: %slinux%s   arch: %s\n\n' "$CB" "$C0" "$(alpine_arch)"

    need_cmd "$BWRAP_BIN" && ok "bwrap: $("$BWRAP_BIN" --version 2>/dev/null || echo present)" || die "bubblewrap missing ($(pkg_hint bubblewrap))"
    need_cmd unshare    && ok "unshare: present"              || die "util-linux unshare missing"
    need_cmd mksquashfs && ok "mksquashfs: present"           || die "squashfs-tools missing ($(pkg_hint squashfs-tools))"
    need_cmd unsquashfs && ok "unsquashfs: present"           || die "squashfs-tools missing"

    need_cmd busybox && ok "busybox: present" || warn "busybox missing (only for the tiny base)"
    need_cmd docker  && ok "docker: $(docker --version | cut -d, -f1)" || warn "docker missing (only for the Debian base)"
    local out
    out="$(unshare --user --map-root-user --mount -- sh -c '
        d=$(mktemp -d); mkdir -p "$d/u" "$d/w" "$d/m" "$d/l"
        mount -t overlay overlay -o "lowerdir=$d/l,upperdir=$d/u,workdir=$d/w" "$d/m" 2>/dev/null && echo yes || echo no
        umount "$d/m" 2>/dev/null || true
        rm -rf "$d"' 2>/dev/null || true)"
    [[ "$out" == yes ]] && ok "unprivileged overlayfs: supported (copy-on-write sandboxes)" || warn "overlayfs not available in userns"

    printf '\n'
    cmd_envs
}

