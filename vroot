    printf '\n'
    printf '%sMORE%s\n' "$CB" "$C0"
    printf '  %-34s %s\n' 'vroot help' 'full help and all options'
    printf '  %-34s %s\n' 'vroot recipe list' 'browse the flag catalog'
    printf '  %-34s %s\n' 'vroot ls' 'list your sandboxes'
    printf '  %-34s %s\n' 'vroot filetype install' 'register the .vroot image file type'
    printf '\n'
    printf '  %sTry one of the commands above, or run "vroot help" for everything.%s\n' "$CD" "$C0"
}

cmd_help() {
    cat <<EOF
vroot $VERSION - a root shell in a sandbox, built from a flag.

USAGE
  vroot [FLAGS] [NAME] [OPTIONS] [-- COMMAND]

  A bare 'vroot' prints this banner. Add flags to include languages/tools.
  A bare NAME makes the sandbox persistent (reuse it by name).

FLAGS (one per tool; combine freely)
  python node deno bun php ruby perl lua r julia
  go rust zig nim crystal d swift
  gcc clang cmake gfortran nasm
  java kotlin scala clojure groovy dotnet fsharp
  haskell elixir erlang ocaml
  sqlite postgres mysql git openssh curl vim
  base
  (run 'vroot recipe list' for the full catalog and 'vroot recipe new NAME' to add your own)

EXAMPLES
  vroot                          root shell (Alpine base)
  vroot -python                  root shell with Python
  vroot -node -python            root shell with Node + Python
  vroot -sqlite -python db       persistent sandbox named 'db'
  vroot -rust -- cargo build     run a command instead of a shell
  vroot -go -v ~/src:/src -- ls /src
  vroot -node -offline           no network
  vroot -python -cwd /tmp        different working directory

OPTIONS
  -v SRC[:DST][:ro]   expose a host path (default: nothing from the host)
  -offline            no network (loopback only)
  -cwd DIR            working directory (default /root)
  -env K=V            set an environment variable
  -name NAME          persistent sandbox name
  -hostname H         hostname inside (default: the sandbox name)
  -clean              empty environment
  -rm                 delete the sandbox after this session

MANAGEMENT
  vroot ls                     list sandboxes
  vroot rm NAME...|--all       delete sandboxes
  vroot save NAME [OUT.vroot]  pack a sandbox into one image file
  vroot IMAGE.vroot            boot from a saved image file
  vroot filetype [install]     register the .vroot image file type with the OS
  vroot recipe list|show|new|edit|path
  vroot envs                   list built env images
  vroot prune                  clear caches/tmp
  vroot info NAME              sandbox details
  vroot doctor                 check the host setup

MACHINE INTERFACE (agents and automation)
  --json                       machine-readable output (build, ls, envs, info)
  vroot build -python --json   {"env":"...","cached":false}
  vroot ls --json              [{"name","env","image","bytes","age_minutes"}]
  vroot envs --json            {"images":[...],"bases":[...]}
  vroot info NAME --json       one sandbox as a JSON object
  JSON goes to stdout, logs to stderr, exit codes are meaningful, and parallel
  builds/launches of the same env are serialised safely.

HOW IT WORKS
  - flags pick recipes -> a single-file env image (envs/*.sqfs) is built once
  - each session runs it via bubblewrap with full root capabilities, its own
    namespaces and its own filesystem; your host is not visible by default
  - the writable layer is a native overlayfs inside a user namespace
  - see docs/BUILDING.md to add your own language/tool
EOF
}

main() {
    ensure_dirs
    local cmd="${1:-}"
    case "$cmd" in
        "")          cmd_banner ;;
        build)       shift; cmd_build "$@" ;;
        ls|list)     shift; cmd_ls "$@" ;;
        rm|delete)   shift; cmd_rm "$@" ;;
        save)        shift; cmd_save "$@" ;;
        load)        shift; cmd_run "$@" ;;
        filetype)    shift; cmd_filetype "$@" ;;
        recipe|recipes) shift; cmd_recipe "$@" ;;
        envs|images) shift; cmd_envs "$@" ;;
        prune|gc)    cmd_prune ;;
        info)        shift; cmd_info "$@" ;;
        doctor)      shift; cmd_doctor "${1:-}" ;;
        help|-h|--help) cmd_help ;;
        version|-V|--version) printf 'vroot %s\n' "$VERSION" ;;
        *)           cmd_run "$@" ;;
    esac
}

main "$@"
